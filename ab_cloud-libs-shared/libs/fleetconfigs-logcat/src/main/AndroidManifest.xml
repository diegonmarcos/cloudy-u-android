<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- #1443 registers the Configs ▸ Logcat tab at process start (FleetLogcatTab → FleetConfigsExtensions). Merged into
             every app that links libs:fleetconfigs-logcat; not exported, answers no query. -->
        <provider
            android:name="com.diegonmarcos.superapp.fleetlogcat.FleetLogcatInitProvider"
            android:authorities="${applicationId}.fleetlogcat.init"
            android:exported="false" />
    </application>
</manifest>
