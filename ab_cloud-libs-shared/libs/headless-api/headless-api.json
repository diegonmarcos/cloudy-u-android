{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "headless-api/1",
  "title": "Headless browser command API",
  "description": "One command API shared by all backends (This App WebView, cloudy-browser-headless container, Cloudflare Browser Run). Transport: POST <base>/command with a Command body, or POST <base>/run with a Run body. Auth: Authorization: Bearer <token>. Reply: {ok, session?, result?, error?}.",
  "version": 1,
  "backends": [
    "cloudflare-browser-run",
    "cloudy-browser-headless",
    "this-app"
  ],
  "defaultBackend": "this-app",
  "limits": {
    "defaultCallTimeoutMs": 30000,
    "maxCallTimeoutMs": 120000,
    "defaultMaxSessions": 4,
    "defaultIdleCloseMs": 300000
  },
  "commands": {
    "open": {
      "params": {
        "url": "string",
        "session": "string?",
        "agent": "string?",
        "profile": "string?"
      },
      "result": "{session,url,title}"
    },
    "close": {
      "params": {
        "session": "string"
      },
      "result": "{closed:boolean}"
    },
    "wait": {
      "params": {
        "selector": "string?",
        "idle": "boolean?",
        "ms": "integer?",
        "timeoutMs": "integer?"
      },
      "oneOf": [
        "selector",
        "idle",
        "ms"
      ],
      "result": "{waited}"
    },
    "eval": {
      "params": {
        "js": "string"
      },
      "result": "any JSON value"
    },
    "click": {
      "params": {
        "selector": "string"
      },
      "result": "{clicked:boolean}"
    },
    "type": {
      "params": {
        "selector": "string",
        "text": "string",
        "clear": "boolean?"
      },
      "result": "{typed:integer}"
    },
    "scroll": {
      "params": {
        "selector": "string?",
        "x": "integer?",
        "y": "integer?"
      },
      "result": "{x,y}"
    },
    "html": {
      "params": {
        "selector": "string?"
      },
      "result": "string"
    },
    "text": {
      "params": {
        "selector": "string?"
      },
      "result": "string"
    },
    "readable": {
      "params": {
        "format": "markdown|json|xml (default markdown)",
        "maxChars": "integer 500..200000 (default 20000)",
        "cursor": "string? (the `next` of a truncated result)"
      },
      "result": "{format,title,url,content,meta{title,url,fetched_at,lang?,excerpt?},chars,truncated,next?; markdown also: markdown,links[{text,href}],tables[markdown]}",
      "formats": {
        "markdown": "default and usually the cheapest in tokens: frontmatter (title, source, fetched_at), headings, lists, GFM tables, fenced code, links; boilerplate, scripts, styles, nav, footers, ads, cookie banners and tracking params removed; base64 images replaced by alt text",
        "json": "compact minified {meta:{title,url,fetched_at,lang},sections:[{h,level,text}],lists:[[item]],tables:[{headers,rows}],links:[{text,href}]}; no nulls, empty keys omitted",
        "xml": "minimal tags, no whitespace: <doc><meta t u f l/><s h l>text</s><ul><i/></ul><table><r h=1><c/></r></table><a href>text</a></doc>"
      },
      "paging": "output is capped at maxChars; when truncated the result carries next, pass it back as cursor on the same session to continue (markdown: character offset at a line boundary; json/xml: block index)"
    },
    "screenshot": {
      "params": {
        "fullPage": "boolean?",
        "selector": "string?",
        "format": "png|jpeg (default png)",
        "quality": "integer 1..100? (jpeg only)"
      },
      "result": "{mime:'image/png'|'image/jpeg',base64}"
    },
    "cookies": {
      "params": {
        "action": "get|set|clear",
        "cookies": "array?"
      },
      "result": "array"
    },
    "storage": {
      "params": {
        "area": "local|session",
        "action": "get|set|remove|clear",
        "key": "string?",
        "value": "string?"
      },
      "result": "object"
    },
    "network": {
      "params": {
        "action": "log|clear|block|unblock",
        "patterns": "array<string>?"
      },
      "result": "array|{blocked:array}"
    },
    "content": {
      "params": {
        "selector": "string?"
      },
      "result": "string (the RENDERED html after scripts ran; same as html, named as Browser Run /content)"
    },
    "pdf": {
      "params": {
        "format": "string? (A4|Letter, default A4)",
        "landscape": "boolean?",
        "printBackground": "boolean?"
      },
      "result": "{mime:'application/pdf',base64}"
    },
    "links": {
      "params": {
        "visibleOnly": "boolean?",
        "sameOrigin": "boolean?"
      },
      "result": "{count,links:[{text,href}]} (absolute http(s) hrefs, deduplicated, document order)"
    },
    "scrape": {
      "params": {
        "elements": "[{selector:string, attrs?:string[]}] 1..20",
        "limit": "integer? per selector (default 100)"
      },
      "result": "{results:[{selector,count,items:[{text,html,attrs{name:value},visible?}]}]}"
    },
    "snapshot": {
      "params": {
        "fullPage": "boolean?",
        "format": "png|jpeg",
        "quality": "integer?"
      },
      "result": "{url,title,html,screenshot:{mime,base64}} (rendered HTML and screenshot of the same moment)"
    }
  },
  "$defs": {
    "Command": {
      "type": "object",
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "enum": [
            "open",
            "close",
            "wait",
            "eval",
            "click",
            "type",
            "scroll",
            "html",
            "text",
            "readable",
            "screenshot",
            "cookies",
            "storage",
            "network",
            "content",
            "pdf",
            "links",
            "scrape",
            "snapshot"
          ]
        },
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "agent": {
          "type": "string",
          "maxLength": 64
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "url": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "idle": {
          "type": "boolean"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "js": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "clear": {
          "type": "boolean"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "fullPage": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "area": {
          "enum": [
            "local",
            "session"
          ]
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": "string"
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "landscape": {
          "type": "boolean"
        },
        "printBackground": {
          "type": "boolean"
        },
        "visibleOnly": {
          "type": "boolean"
        },
        "sameOrigin": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "selector"
            ],
            "properties": {
              "selector": {
                "type": "string"
              },
              "attrs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "Run": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "stepTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "stopOnError": {
          "type": "boolean",
          "default": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Command"
          }
        }
      }
    },
    "Reply": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "session": {
          "type": "string"
        },
        "result": {},
        "error": {
          "$ref": "#/$defs/Error"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reply"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "bad_request",
            "unauthorized",
            "not_found",
            "timeout",
            "limit",
            "denied",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "http": {
    "GET /health": "no auth, {ok,sessions,max}",
    "POST /command": "Command -> Reply",
    "POST /run": "Run -> Reply",
    "GET /sessions": "list",
    "DELETE /sessions/{id}": "close",
    "POST /cdp": "phone only: {on:boolean}; opt-in DevTools/CDP relay (default off, token-gated, auto-off)"
  },
  "mesh": {
    "phone": "/browser/{command|run|status|stop|cdp} on Cloud-Webserver's mesh listener (bearer, mesh peers only)",
    "container": "https://mcp.diegonmarcos.com/cloudy-browser-headless/{health|command|run|sessions} (wg-only Caddy path route, bearer)"
  },
  "commandsDoc": "content/links/scrape/snapshot/pdf mirror the Cloudflare Browser Run endpoints (content, links, scrape, snapshot, pdf; read = markdown; json = gateway composite). The gateway (cloud-infra-mcp browser.*) turns url+options into open+command(s) on a session backend, or one REST call on the cloudflare backend.",
  "gateway": {
    "description": "The c3 MCP browser.* tools are the single entry point. backend auto (default) = container first, then cloudflare on a bot wall.",
    "backends": [
      "auto",
      "container",
      "phone",
      "cloudflare"
    ],
    "defaultBackend": "auto",
    "tools": {
      "browser.read": {
        "cloudflare": "POST /accounts/{id}/browser-rendering/markdown",
        "formats": [
          "markdown",
          "json",
          "xml"
        ],
        "note": "json/xml are produced by the container readable; on cloudflare the markdown is converted by the gateway"
      },
      "browser.content": {
        "cloudflare": "POST .../content"
      },
      "browser.screenshot": {
        "cloudflare": "POST .../screenshot (screenshotOptions{fullPage,type,quality}, binary body)"
      },
      "browser.pdf": {
        "cloudflare": "POST .../pdf (binary body)"
      },
      "browser.links": {
        "cloudflare": "POST .../links (visibleLinksOnly; sameOrigin filtered by the gateway)"
      },
      "browser.scrape": {
        "cloudflare": "POST .../scrape (elements[{selector}])"
      },
      "browser.json": {
        "cloudflare": "POST .../json (prompt, response_format{type:json_schema,json_schema}); container/phone: page markdown plus OpenRouter model chosen by C3_BROWSER_JSON_MODEL",
        "gatewayOnly": true,
        "params": {
          "url": "string",
          "prompt": "string?",
          "schema": "object (JSON schema)?"
        },
        "result": "{data}"
      },
      "browser.snapshot": {
        "cloudflare": "POST .../snapshot (content + base64 screenshot)"
      },
      "browser.ocr": {
        "containerOnly": true,
        "containerCommand": "ocr (container extension: not in `commands`, the phone engine does not implement it)",
        "params": {
          "url": "string (or session of an open page)",
          "engine": "tesseract|paddle? (default tesseract; paddle needs the PaddleOCR sidecar PADDLE_OCR_URL)",
          "minWidth": "integer? (default 150)",
          "minHeight": "integer? (default 150)",
          "includeScreenshot": "boolean? (also OCR the rendered page)",
          "lang": "eng|fra|deu|spa|ita|por, joined with + (default eng)",
          "maxImages": "integer? (default 12, max 50)",
          "escalateBelow": "number 0..100? (re-run low-confidence images on paddle, default off)"
        },
        "result": "{images_found, images_ocr, images_failed, truncated, results:[{kind img|screenshot, src, alt, width, height, ocr_text, confidence 0..100, engine, low_confidence?, error?}], text}"
      }
    },
    "support": {
      "read": {
        "container": true,
        "phone": true,
        "cloudflare": true
      },
      "content": {
        "container": true,
        "phone": true,
        "cloudflare": true
      },
      "screenshot": {
        "container": true,
        "phone": "viewport only, no fullPage/selector-less crop",
        "cloudflare": true
      },
      "pdf": {
        "container": true,
        "phone": false,
        "cloudflare": true
      },
      "links": {
        "container": true,
        "phone": true,
        "cloudflare": true
      },
      "scrape": {
        "container": true,
        "phone": true,
        "cloudflare": true
      },
      "json": {
        "container": "openrouter",
        "phone": "openrouter",
        "cloudflare": true
      },
      "snapshot": {
        "container": true,
        "phone": true,
        "cloudflare": true
      },
      "ocr": {
        "container": true,
        "phone": false,
        "cloudflare": false
      },
      "session tools (open,eval,click,type,wait,scroll,cookies,storage,network,run)": {
        "container": true,
        "phone": true,
        "cloudflare": false
      }
    },
    "fallback": {
      "trigger": "bot wall: challenge title or markers (Just a moment, Performing security verification, Attention Required, cf-challenge, cf-turnstile, captcha, verify you are human, Access denied), HTTP 403/429/503 with a cf-mitigated or challenge header, or an empty body with a challenge redirect (/cdn-cgi/challenge-platform, challenge_redirect)",
      "action": "retry the SAME call via the cloudflare backend (Cloudflare's own rendering service, which identifies itself as a bot); never solve CAPTCHAs, spoof fingerprints or rotate proxies; if cloudflare is refused too, the challenge result is returned honestly",
      "result": "adds backend_used and fallback_reason",
      "domainMemory": "per-domain 'needs cloudflare' with a 24 h TTL",
      "cost": "each cloudflare call is logged (usage + estimated cost); a daily cap (C3_BROWSER_CF_DAILY_CAP, default 200 calls) refuses further cloudflare calls"
    }
  }
}
