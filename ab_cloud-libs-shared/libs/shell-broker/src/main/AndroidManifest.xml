<?xml version="1.0" encoding="utf-8"?>
<!-- #1510 libs:shell-broker, SuperApp only. The three doors are signature-guarded (CONSTELLATION_DATA, the fleet key).
     NO foreground service, NO <receiver>, NO BOOT_COMPLETED, NO START_STICKY: the broker runs on a call or a bind and goes idle.
     Guard: aa_cloud-superapp/test/test-shell-broker-guards.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.diegonmarcos.superapp.shellbroker.ShellBrokerProvider"
            android:authorities="${applicationId}.shellbroker"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
        <service
            android:name="com.diegonmarcos.superapp.shellbroker.ShellBrokerService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
        <!-- #1712 THE trampoline is excludeFromRecents, so it must never be the root of the OWNER's task: another app's ADB button starts it with
             NEW_TASK, and with the default (package) affinity a cold start made it the root of the owner's task, which Android then hid from
             Recents for good (the app could not be switched back to). taskAffinity="" puts it in its own throwaway task; it starts the owner's
             MainActivity (singleTask, package affinity) into the owner's own, listed task and finishes. Guard: c3-webserver test-c3-webserver-task-flags.sh. -->
        <activity
            android:name="com.diegonmarcos.superapp.shellbroker.ShellArmActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.diegonmarcos.superapp.action.ARM_SHELL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
