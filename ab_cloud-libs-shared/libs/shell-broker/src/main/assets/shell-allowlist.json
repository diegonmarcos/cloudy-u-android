{
 "_doc": "#1510 THE per-caller command allowlist of the SuperApp's shell broker (libs:shell-broker). Default deny: a caller with no entry, or a command no rule of that caller matches, is refused. `re` is a full-match regex over the trimmed command; a shell metacharacter (; & | ` $ < > ( ) { } \\ #) is refused unless the rule lists it in `meta`. Key = the caller package resolved from the binder uid (cld.termux and cld.termux.nix share a uid), or an alias below. An app that links libs:shell-client MUST have an entry here (guard test-shell-broker-guards.sh). `stdin` (#1512) = the rules of the stdin door (`pm install -S <size>`, `pm install-write -S <size> ... -`), each with a `maxBytes` cap; a caller without them may stream nothing. A trailing ` 2>&1` is the one redirect a command may end with. `exact` = literal command lines (the SuperApp's X-Ray probes), `segments` = `;`/newline separate commands and each must match (the Background policy chains); both are per-caller data, never a client choice.",
 "aliases": {
  "com.diegonmarcos.cloudwebserver": "mesh"
 },
 "callers": {
  "com.diegonmarcos.superapp": {
   "why": "The broker's own host: X-Ray, Background policy, Super Saving, device tuning, perms, installs, diagnostics (internal callers).",
   "segments": true,
   "allow": [
    {
     "id": "roles-read-1",
     "why": "#1688 read-only: who holds a role (Perms > Roles held).",
     "re": "^cmd role get-role-holders(-as-user)? android\\.app\\.role\\.[A-Z_]+( [0-9]+)?$"
    },
    {
     "id": "roles-read-2",
     "why": "#1688 read-only: the role and device-policy dumps the Roles held section parses.",
     "re": "^dumpsys (role|device_policy)$"
    },
    {
     "id": "roles-release-self",
     "why": "#1688 release a role / admin held by the SuperApp ITSELF (behind a confirm dialog); no other package.",
     "re": "^(cmd role remove-role-holder android\\.app\\.role\\.[A-Z_]+ com\\.diegonmarcos\\.superapp( [0-9]+)?|dpm remove-active-admin --user 0 com\\.diegonmarcos\\.superapp/[\\w.$]+)$"
    },
    {
     "id": "reads-1",
     "re": "^dumpsys [\\w.:/=,@+*?-]+( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "reads-2",
     "re": "^settings (get|list) (global|system|secure)( [\\w.:/=,@+*?-]+)?$"
    },
    {
     "id": "reads-3",
     "re": "^appops get [a-z][\\w.]*( [A-Z_]+)?$"
    },
    {
     "id": "reads-4",
     "re": "^getprop( [\\w.]+)?$"
    },
    {
     "id": "reads-5",
     "re": "^cat /(proc|sys)/[\\w/.:@-]+$"
    },
    {
     "id": "reads-6",
     "re": "^ps( -[\\w]+)*( -o [\\w,=]+)?$"
    },
    {
     "id": "reads-7",
     "re": "^pm (list|path|dump|get-install-location)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "bgpolicy-1",
     "re": "^appops set [a-z][\\w.]* [A-Z_]+ (allow|deny|ignore|default|foreground)$"
    },
    {
     "id": "bgpolicy-2",
     "re": "^am (force-stop|kill|get-standby-bucket|get-inactive|set-standby-bucket|set-inactive|set-idle|stop-service|broadcast)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "bgpolicy-3",
     "re": "^cmd (deviceidle|appops|battery|jobscheduler|activity)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "bgpolicy-4",
     "re": "^pm (enable|disable|disable-user|enable-user|suspend|unsuspend|trim-caches|clear)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "selfgrant-wss",
     "re": "^pm grant com\\.diegonmarcos\\.superapp android\\.permission\\.WRITE_SECURE_SETTINGS$"
    },
    {
     "id": "selfgrant-runtime",
     "re": "^pm grant com\\.diegonmarcos\\.superapp android\\.permission\\.(ACCESS_BACKGROUND_LOCATION|ACCESS_COARSE_LOCATION|ACCESS_FINE_LOCATION|ACTIVITY_RECOGNITION|BLUETOOTH_ADVERTISE|BLUETOOTH_CONNECT|BLUETOOTH_SCAN|BODY_SENSORS|CAMERA|DUMP|NEARBY_WIFI_DEVICES|PACKAGE_USAGE_STATS|POST_NOTIFICATIONS|READ_CALENDAR|READ_CONTACTS|READ_EXTERNAL_STORAGE|READ_LOGS|READ_MEDIA_AUDIO|READ_MEDIA_IMAGES|READ_MEDIA_VIDEO|READ_PHONE_NUMBERS|READ_PHONE_STATE|READ_SMS|RECORD_AUDIO|SEND_SMS|WRITE_CALENDAR|WRITE_CONTACTS|WRITE_EXTERNAL_STORAGE)$"
    },
    {
     "id": "selfgrant-location",
     "re": "^cmd location set-location-enabled (true|false)$"
    },
    {
     "id": "fleetgrant-wss",
     "re": "^pm grant com\\.diegonmarcos\\.[a-z][a-z0-9_.]* android\\.permission\\.WRITE_SECURE_SETTINGS$"
    },
    {
     "id": "perms-1",
     "re": "^pm (grant|revoke) [a-z][\\w.]* [\\w.]+$"
    },
    {
     "id": "perms-2",
     "re": "^appops set [a-z][\\w.]* [A-Z_]+ (allow|deny|ignore|default|foreground)$"
    },
    {
     "id": "tuning-1",
     "re": "^settings put (global|system|secure) [\\w.]+ [\\w.:/=,@+*?-]+$"
    },
    {
     "id": "tuning-2",
     "re": "^device_config put [\\w.:/=,@+*?-]+( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "tuning-3",
     "re": "^wm (density|size)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "tuning-4",
     "re": "^cmd (uimode|display|power)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "installs-1",
     "re": "^pm (install|install-create|install-write|install-commit|install-abandon|uninstall)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "selfdiag-1",
     "_doc_1688": "#1688 role writes are never a diagnostic: remove-role-holder is only roles-release-self (own package).",
     "re": "^(?!cmd role (add|remove)-role-holder )(logcat|uptime|id|df|netstat|ip|ss|cmd)( [\\w.:/=,@+*?-]+)*$"
    },
    {
     "id": "bg-echo",
     "re": "^echo '[#@\\w.:-]+'$",
     "meta": "#"
    },
    {
     "id": "bg-component",
     "re": "^pm (enable|disable) '[a-z][\\w.]*/[\\w.$]+'$",
     "meta": "$"
    },
    {
     "id": "bg-settings",
     "re": "^settings (get|put|delete) (global|system|secure) [\\w.-]+( [\\w.-]+)?$"
    },
    {
     "id": "bg-ps",
     "re": "^ps -A -o NAME$"
    },
    {
     "id": "bg-idle",
     "re": "^cmd deviceidle (whitelist( [+-][\\w.]+)?|force-idle|unforce)$"
    },
    {
     "id": "account-roles",
     "re": "^cmd role (add-role-holder|get-role-holders) android\\.app\\.role\\.[A-Z_]+( [a-z][\\w.]*)?$"
    },
    {
     "id": "account-listener",
     "re": "^cmd notification allow_listener [a-z][\\w.]*/[\\w.]+$"
    }
   ],
   "exact": [
    "dumpsys usagestats | grep -E 'package=.*totalTimeForegroundServiceUsed=' | head -60",
    "logcat -d -b system,main -v time ActivityManager:I '*:S' | grep 'Start proc'",
    "dumpsys jobscheduler | grep -E 'JOB #|Pending queue|Active jobs|Registered|Standby bucket|Backoff' | head -400",
    "dumpsys alarm | head -1500",
    "dumpsys power | grep -E 'Wake Locks|WAKE_LOCK|mWakefulness|mWakeLockSummary|Suspend Blockers|Display Power|mHoldingWakeLock' | head -200",
    "dumpsys thermalservice | head -300",
    "dumpsys netstats --uid | head -600",
    "for k in ro.product.manufacturer ro.product.model ro.build.version.release ro.build.version.sdk ro.build.fingerprint ro.soc.manufacturer ro.soc.model ro.hardware ro.board.platform ro.hardware.egl ro.hardware.vulkan ro.opengles.version; do echo \"$k=$(getprop $k)\"; done; for c in /sys/devices/system/cpu/cpu[0-9]*; do echo \"$(basename $c) max=$(cat $c/cpufreq/cpuinfo_max_freq 2>/dev/null) gov=$(cat $c/cpufreq/scaling_governor 2>/dev/null)\"; done; wm size; wm density; uptime",
    "o=$(top -b -n 1 -m 15 -s 9 2>/dev/null | head -40); if [ -n \"$o\" ]; then echo \"$o\"; else dumpsys cpuinfo | head -40; fi",
    "dumpsys gfxinfo com.diegonmarcos.superapp framestats | grep -vE '^[0-9,]+$' | head -300",
    "dumpsys SurfaceFlinger | grep -iE 'GLES|missed|refresh|jank|total frames' | head -60",
    "dumpsys notification | grep -E 'AggregatedStats|key=|numPostedByApp|numUpdatedByApp|numRemovedByApp|numQuotaViolations|NotificationRecord\\(' | head -3000",
    "dumpsys binder_calls_stats 2>/dev/null | head -400",
    "dumpsys meminfo | head -600",
    "logcat -d -b events -v threadtime -t 3000 2>/dev/null | grep am_anr | tail -20; echo ---; ls -l /data/anr 2>&1 | tail -20",
    "echo deep=$(dumpsys deviceidle get deep) light=$(dumpsys deviceidle get light); dumpsys deviceidle whitelist",
    "for p in $(pm list packages | grep com.diegonmarcos | cut -d: -f2); do echo \"$p $(am get-standby-bucket $p)\"; done; echo ---; dumpsys usagestats | grep -E 'package=.*bucket=' | head -300",
    "echo ignore:; cmd appops query-op RUN_IN_BACKGROUND ignore; echo deny:; cmd appops query-op RUN_IN_BACKGROUND deny",
    "echo credential_service=$(settings get secure credential_service); echo primary=$(settings get secure credential_service_primary)",
    "logcat -d -v threadtime -t 300 '*:W'",
    "dumpsys package com.diegonmarcos.superapp | grep -E 'granted=true' | head -120; echo ---; cmd appops get com.diegonmarcos.superapp | head -80",
    "df -h 2>&1 | head -40",
    "dumpsys diskstats | head -120",
    "dumpsys dropbox --print 2>/dev/null | grep -E '^(Process|Package|Subject): |^[0-9]{4}-[0-9]{2}-[0-9]{2} .*(crash|anr)' | head -300",
    "dumpsys connectivity | head -200",
    "dumpsys telephony.registry | grep -E 'mSignalStrength|mServiceState|mDataConnectionState|mCallState|mNetworkType' | head -40",
    "dumpsys activity processes | head -200",
    "dumpsys package com.diegonmarcos.superapp | grep -E -A70 'requested permissions:|install permissions:|runtime permissions:' | head -260"
   ]
  },
