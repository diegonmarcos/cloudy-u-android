 "terminal": {
  "_doc": "#1550 The SuperApp ADB Shell terminal's declared palette, next to the allowlist that permits it: every snippet runs as the SuperApp caller and must match one of its allow rules (TerminalDeclTest); `confirm` lists the destructive commands the terminal asks about before running (any segment matching); `suggest` feeds autocomplete with command stems. Read by aa_cloud-superapp TerminalModel; the broker ignores this block.",
  "groups": [
   "packages",
   "settings",
   "appops",
   "dumpsys",
   "logcat",
   "network",
   "battery",
   "device"
  ],
  "snippets": [
   {
    "id": "pkg-user",
    "group": "packages",
    "label": "User packages",
    "cmd": "pm list packages -3"
   },
   {
    "id": "pkg-disabled",
    "group": "packages",
    "label": "Disabled packages",
    "cmd": "pm list packages -d"
   },
   {
    "id": "pkg-system",
    "group": "packages",
    "label": "System packages",
    "cmd": "pm list packages -s"
   },
   {
    "id": "pkg-path",
    "group": "packages",
    "label": "SuperApp APK path",
    "cmd": "pm path com.diegonmarcos.superapp"
   },
   {
    "id": "pkg-dump",
    "group": "packages",
    "label": "SuperApp package dump",
    "cmd": "dumpsys package com.diegonmarcos.superapp"
   },
   {
    "id": "set-global",
    "group": "settings",
    "label": "Global settings",
    "cmd": "settings list global"
   },
   {
    "id": "set-secure",
    "group": "settings",
    "label": "Secure settings",
    "cmd": "settings list secure"
   },
   {
    "id": "set-adbwifi",
    "group": "settings",
    "label": "Wireless debugging switch",
    "cmd": "settings get global adb_wifi_enabled"
   },
   {
    "id": "set-adb",
    "group": "settings",
    "label": "USB debugging switch",
    "cmd": "settings get global adb_enabled"
   },
   {
    "id": "ops-self",
    "group": "appops",
    "label": "SuperApp app-ops",
    "cmd": "appops get com.diegonmarcos.superapp"
   },
   {
