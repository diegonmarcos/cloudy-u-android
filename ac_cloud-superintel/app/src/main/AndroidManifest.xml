<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The fleet agent gateway (my-ai-api, mesh only) is the only road out; Cloud Account is opened by a package-pinned intent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The chat's (+) menu: Camera takes a picture, Image lists the phone's photos. Both are libs:perms rows (build.json::perms.needs), granted
         on Configs > Perms; the chat asks for nothing itself and shows "Fix in Perms" while one is missing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Profile at the top right opens Cloud Account (com.diegonmarcos.cloudaccount.OPEN, libs:bottomnav AccountLaunch). -->
    <queries>
        <package android:name="com.diegonmarcos.cloudaccount" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudSuperIntel"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudSuperIntel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- #1543 Another app opens a page: com.diegonmarcos.cloudsuperintel.OPEN with extras section/page
                 (the Cloud SuperApp Notify AI badge opens Cost). -->
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudsuperintel.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Share > SI of plain text moved to AskAiActivity (one entry in the share sheet): the text lands in a composer, nothing is
                 sent until the user does. MainActivity.shared() still serves an explicit SEND intent. -->
        </activity>

        <!-- Ask AI: Cloud SI in the open-with chooser (VIEW of any mime, content:// and file://), the share sheet (SEND, SEND_MULTIPLE
             of any file or text) and the text selection toolbar (PROCESS_TEXT). The intent's own URI grant is the only access: no
             storage permission. AskAiActivity copies the content into the cache and opens a new SI chat with it attached. -->
        <activity
            android:name=".AskAiActivity"
            android:exported="true"
            android:label="@string/ask_cloud_si_label"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudSuperIntel">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/uri-list" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/uri-list" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
