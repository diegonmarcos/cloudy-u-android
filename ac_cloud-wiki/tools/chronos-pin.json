{
  "_doc": "#1789 THE pin of the Chronos pages Cloud Wiki bakes into the APK. tools/regen-chronos.py reads this file, clones `url` at `commit`, copies every file of `source_dir` into `assets_dir`/<source_dir> (HTML rewritten so every CDN script, stylesheet and font named under `vendor` / `fonts` is answered from `assets_dir`/vendor), and declares one nested page per index.html under build.json::ui wiki > chronos (ids from the directory numbers, labels the pages' own <title>). `--check` regenerates into a scratch dir and fails on any byte of drift; test/test-chronos.sh runs it in the ship workflow. Re-pin: tools/regen-chronos.py --pin <sha|main>, which also re-hashes the vendored files. `sha256` values are written by --pin and verified on every regeneration; never typed.",
  "repo": "diegonmarcos/lib-chronos",
  "url": "https://github.com/diegonmarcos/lib-chronos.git",
  "ref": "main",
  "commit": "0cb1c9638fe671cc40211336bc53f4ec27ee57db",
  "source_dir": "Chronos",
  "assets_dir": "app/src/main/assets/chronos",
  "serve_path": "/chronos/",
  "nav": {
    "_doc": "Where the pages are declared: build.json::ui.sections[section].pages[parent].pages (nested, the repo's directory hierarchy). id = id_prefix for the root, id_prefix + '.' + the leading number of the directory (3.0.Quantum-Decoherence-Cycle -> chronos.lib.3.0), else its lower-case slug. icons: per directory relative to source_dir ('' = the root), default_icon for any other; every name is in the libs:ui-icons catalog.",
    "section": "wiki",
    "parent": "chronos",
    "id_prefix": "chronos.lib",
    "default_icon": "description",
    "icons": {
      "": "timeline",
      "0.Humansphere-Circadian": "bedtime",
      "1.Earthsphere-Cycles": "public",
      "2.Milkwaysphere-Orbits": "language",
      "3.Quantum-Cycles": "hub",
      "3.Quantum-Cycles/3.0.Quantum-Decoherence-Cycle": "schedule",
      "3.Quantum-Cycles/3.1.Quantum-Gravity-Cycle": "rocket_launch",
      "4.Astronomy-Astrological-sphere": "auto_awesome"
    },
    "root_label": "All cycles",
    "title_suffix": " - Chronos",
    "_doc_labels": "#1831 menu names: a page's name is the <h2> of the card that links to it on a hub page of the repo (the repo's own names: Humansphere - Circadian, ...), else its <title> without title_suffix; the repo's root page is root_label. The pages sit FLAT under the Chronos topic: the root page first, then the first-level sections in repo order, deeper pages nested under their section."
  },
