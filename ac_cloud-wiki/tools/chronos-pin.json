  "fonts": {
    "_doc": "A Google Fonts css2 URL in a page (https://fonts.googleapis.com/css2?family=...) is answered by a generated stylesheet vendor/fonts/<families>.css with one @font-face per family and weight, latin subset, from the pinned @fontsource packages (the same font files, SIL OFL 1.1). A family a page asks for that is not listed here fails the regeneration.",
    "match_prefix": "https://fonts.googleapis.com/css2?",
    "license": "SIL OFL 1.1",
    "url": "https://cdn.jsdelivr.net/npm/@fontsource/{slug}@{version}/files/{slug}-latin-{weight}-normal.woff2",
    "families": {
