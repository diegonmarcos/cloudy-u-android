  "runtime": {
    "_doc": "#1830 the app clones the repo at run time, read-only, and refreshes it per one of these modes (the user picks one on the Chronos page; `default` until then). max_age_minutes: how old the clone may get before the app refreshes it when Chronos is opened or the app starts; -1 = only when the user taps Refresh.",
    "refresh": {
      "default": "on_open",
      "modes": [
        {
          "id": "manual",
          "label": "Manual (Refresh button only)",
          "max_age_minutes": -1
        },
        {
          "id": "on_open",
          "label": "Every time Chronos opens",
          "max_age_minutes": 0
        },
        {
          "id": "every_6h",
          "label": "Every 6 hours",
          "max_age_minutes": 360
        },
        {
          "id": "daily",
          "label": "Once a day",
          "max_age_minutes": 1440
        }
      ]
    }
  }
