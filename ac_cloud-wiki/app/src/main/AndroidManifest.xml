<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #1830 INTERNET for ONE thing: Chronos clones diegonmarcos/lib-chronos at run time (read-only, libs:git-core). The wiki pages
         are the runtime dataset Cloud Store serves; the Chronos web view still answers every off-origin request 403.
         Cloud Account is opened by a package-pinned intent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.diegonmarcos.cloudaccount" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudWiki"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CloudWiki">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
