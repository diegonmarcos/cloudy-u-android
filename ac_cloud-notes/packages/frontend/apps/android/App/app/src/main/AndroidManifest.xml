<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Vault view, store route: the package that owns the fleet shared store's
             ContentProvider must be visible (build.json::vault.open.store.owner_package; pinned
             to ac_cloud-termux by test-vault.sh). A provider entry here would clash with the
             application providers in the manifest merge. -->
        <package android:name="cld.termux" />
        <!-- #1717 Source > Nix home: the root answers "not installed" from a package lookup (build.json::vault.sources.roots). -->
        <package android:name="cld.termux.nix" />
    </queries>

    <application
        android:name=".CloudNotesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- #1642 text files from other apps (Open with): opened as a note (MainActivity captures the intent, the editor imports it). Text types only, never binary. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/x-log" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
            </intent-filter>
            <!-- #1642 text files a file manager reports with a generic type (octet-stream or empty): matched by extension, one .* per extra dot in the name (the matcher does not backtrack). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\..*\\.log" />
                <data android:pathPattern=".*\\..*\\..*\\.log" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.json" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\..*\\.csv" />
                <data android:pathPattern=".*\\..*\\..*\\.csv" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\..*\\.conf" />
                <data android:pathPattern=".*\\..*\\..*\\.conf" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\.yml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\..*\\.xml" />
                <data android:pathPattern=".*\\..*\\..*\\.xml" />
            </intent-filter>

            <!-- #1866 offered for every file, exactly like Cloud Drive: the same three typed filters (media; text, documents and the OpenDocument family;
                 and a bare */*) for VIEW and EDIT on content:// and file://. MainActivity routes with OpenRouter: text to the editor import
                 (an EDIT on a writable content URI saves back), images/PDF/audio/video to FileViewActivity's viewer, any other binary to its
                 file view. SEND and SEND_MULTIPLE are declared below (#1888). -->
            <intent-filter android:label="@string/title_activity_main">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- #1949 the PDF entry of the Open-with list, labelled for what it does. -->
            <intent-filter android:label="@string/open_pdf_in_notes">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="@string/title_activity_main">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text-template" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet-template" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation-template" />
            </intent-filter>
            <intent-filter android:label="@string/title_activity_main">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- DE-CLOUDED (#469): the cloud-notes://authentication deep link reached
                 the Cloud Notes auth flow, which does not exist here. -->

            <!-- #1888 the share sheet: SEND and SEND_MULTIPLE for any type plus text/plain (EXTRA_TEXT). MainActivity.captureViewIntent routes the
                 streams through the VIEW path (text to the editor import, other types to the file view); EXTRA_TEXT becomes a new note. -->
            <intent-filter android:label="@string/share_open_with">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_open_with">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- #1866 viewer and file view for what is not text (images, PDF, audio, video, other binary); reached from MainActivity only. -->
        <activity
            android:name=".FileViewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- #1949 Cloud Notes' own PDF reader and editor (libs:pdf); reached from FileViewActivity only. -->
        <activity
            android:name=".PdfViewActivity"
            android:exported="false"
            android:label="@string/open_pdf_in_notes"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- #469 emulated-storage open-file: MANAGE_EXTERNAL_STORAGE is the
         Android 11+ mechanism that lets a file-manager-style app read
         /storage/emulated/0/... by raw path after the user grants All-files
         access in Settings (checked via Environment.isExternalStorageManager
         in ExternalFilePlugin). READ_EXTERNAL_STORAGE covers Android 10 and
         older. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Vault view: the fleet shared store's provider (signature permission, granted only
         to apps signed with the constellation key; build.json::vault.open.store). -->
    <uses-permission android:name="com.diegonmarcos.cloud.permission.SHARED_STORE" />
</manifest>
