 "ticketers": [
  {
   "id": "ticketmaster",
   "label": "Ticketmaster",
   "color": "#026CDF",
   "home": "https://www.ticketmaster.com",
   "terms_url": "https://developer.ticketmaster.com/support/terms-of-use/",
   "coverage": [
