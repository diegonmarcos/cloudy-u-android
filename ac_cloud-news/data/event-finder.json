  },
  {
   "id": "ra",
   "label": "Resident Advisor",
   "short": "RA",
   "color": "#D81B60",
   "home": "https://ra.co",
   "terms_url": "https://ra.co/terms",
   "coverage": null,
   "needs_city_field": "ra_area",
   "auth": {
    "type": "none"
   },
   "enabled_default": false,
   "cache_hours": 12,
   "min_interval_hours": 6,
   "fetch": {
    "kind": "graphql",
    "how": "RA's public listings GraphQL endpoint (undocumented, the one ra.co's own pages call); opt-in, polite: one query per city per 12 h",
    "method": "POST",
    "url": "https://ra.co/graphql",
    "headers": {
     "Content-Type": "application/json",
     "Referer": "https://ra.co/events"
    },
    "body": {
     "operationName": "GET_EVENT_LISTINGS",
     "variables": {
      "filters": {
       "areas": {
        "eq": "{ra_area}"
       },
       "listingDate": {
        "gte": "{from_iso}",
        "lte": "{to_iso}"
       }
      },
      "pageSize": 50,
      "page": 1
     },
     "query": "query GET_EVENT_LISTINGS($filters: FilterInputDtoInput, $pageSize: Int, $page: Int) { eventListings(filters: $filters, pageSize: $pageSize, page: $page, sort: {listingDate: {priority: 1, order: ASCENDING}}) { data { id listingDate event { id title date startTime endTime contentUrl flyerFront venue { name area { name } } artists { name } } } totalResults } }"
    },
    "hosts": [
     "ra.co"
    ],
    "parser": "ra",
    "robots": true
   },
   "note": "Opt-in: the endpoint is not a documented public API, so it is off until you switch it on. Only covers cities with an ra_area."
  },
