    "help_url": "https://developer-acct.ticketmaster.com/user/register"
   },
   "enabled_default": true,
   "cache_hours": 6,
   "min_interval_hours": 1,
   "fetch": {
    "kind": "api",
    "how": "Ticketmaster Discovery API v2 (public, free key, 5000 calls/day, 5/s)",
    "method": "GET",
    "url": "https://app.ticketmaster.com/discovery/v2/events.json",
    "query": {
     "apikey": "{key}",
     "latlong": "{lat},{lng}",
     "radius": "{radius_km}",
     "unit": "km",
     "startDateTime": "{from_iso}",
     "endDateTime": "{to_iso}",
     "size": "100",
     "sort": "date,asc",
     "classificationName": "{category_param}"
    },
    "hosts": [
     "app.ticketmaster.com"
    ],
    "parser": "ticketmaster"
   },
   "note": "Official API. Needs your own key (Configs > Events)."
  },
  {
