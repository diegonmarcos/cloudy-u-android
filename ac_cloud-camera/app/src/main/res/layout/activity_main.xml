<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.activities.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root"
        tools:context=".ui.activities.MainActivity">

        <FrameLayout
            android:id="@+id/main_frame"
            android:layout_above="@id/camera_mode_tabs"
            android:layout_height="match_parent"
            android:layout_width="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/preview_container"
                android:layout_height="match_parent"
                android:layout_width="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="9:16"
                    app:layout_constraintVertical_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <cld.camera.ui.QROverlay
                    android:id="@+id/qr_overlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview" />

                <!-- #1533 Objects: the live detection boxes, over exactly the preview's bounds. -->
                <com.diegonmarcos.superapp.vision.DetectionOverlayView
                    android:id="@+id/objects_overlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview" />

                <!-- #1533 VR: the composited frames (filters on the camera), over exactly the preview's bounds. -->
                <com.diegonmarcos.superapp.vision.CompositeFrameView
                    android:id="@+id/vr_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview" />

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:id="@+id/focusRing"
                    android:src="@drawable/focus_ring"
                    android:visibility="invisible"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"/>

                <!-- Hides part of focus ring that is outside of the preview by occupying the area below the preview. -->
                <View
                    android:id="@+id/bottom_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@android:color/black"
                    app:layout_constraintTop_toBottomOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <FrameLayout
                    android:id="@+id/g_circle_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/g_circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:rotation="0"
                        android:paddingBottom="14sp"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/g_circle_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp"
                            android:shadowColor="#000000"
                            android:shadowDx="1.5"
                            android:shadowDy="1.3"
                            android:shadowRadius="1.6"
                            android:textColor="@android:color/white"
                            android:textAlignment="center"/>

                        <View
                            android:id="@+id/g_circle_line_x"
                            android:background="@drawable/white_shadow_rect"
                            android:layout_width="120dp"
                            android:layout_gravity="center"
                            android:layout_height="2dp"/>

                    </LinearLayout>

                    <View
                        android:id="@+id/g_circle_line_z"
                        android:background="@drawable/yellow_shadow_rect"
                        android:layout_width="100dp"
                        android:layout_gravity="center"
                        android:layout_height="1.5dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/g_circle_left_dash"
                            android:background="@drawable/white_shadow_rect"
                            android:layout_width="8dp"
                            android:layout_height="2dp"/>

                        <View
                            android:background="@android:color/transparent"
                            android:layout_width="120dp"
                            android:layout_height="1dp"/>

                        <View
                            android:id="@+id/g_circle_right_dash"
                            android:layout_width="8dp"
                            android:layout_height="2dp"
                            android:background="@drawable/white_shadow_rect"/>

                    </LinearLayout>

                </FrameLayout>

                <cld.camera.ui.CountDownTimerUI
                    android:id="@+id/c_timer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:shadowColor="#000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.6"
                    android:textColor="@android:color/white"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview"/>

                <cld.camera.ui.CustomGrid
                    android:id="@+id/preview_grid"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview"/>

                <ImageView
                    android:id="@+id/main_overlay"
                    android:scaleType="fitStart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/loading_camera"
                    app:layout_constraintTop_toTopOf="@id/preview"
                    app:layout_constraintStart_toStartOf="@id/preview"
                    app:layout_constraintEnd_toEndOf="@id/preview"
                    app:layout_constraintBottom_toBottomOf="@id/preview"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:layout_above="@id/three_buttons"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/mute_toggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/mic_on"
                    android:background="@color/red"
                    app:contentPadding="8dp"
                    android:layout_gravity="center"
                    app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                    android:tooltipText="@string/tap_to_mute_audio"
                    android:contentDescription="@string/mute_audio"
                    android:visibility="gone" />

            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- #1533 Objects controls: pause / resume the analysis, the confidence threshold, a status line.
             Shown only on the Objects page; the shutter is its snapshot (frame + JSON detections). -->
        <LinearLayout
            android:id="@+id/objects_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/three_buttons"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="#99000000"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/objects_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:text="@string/objects_looking" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/objects_pause"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="@string/objects_pause" />

                <SeekBar
                    android:id="@+id/objects_threshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="95"
                    android:contentDescription="@string/objects_threshold_label" />

                <TextView
                    android:id="@+id/objects_threshold_value"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- #1533 VR controls: the declared filters as chips (one per kind), Record. The shutter saves the composited photo. -->
        <LinearLayout
            android:id="@+id/vr_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/three_buttons"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="#99000000"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:text="@string/vr_pick" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/vr_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/vr_record"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="@string/vr_record" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/three_buttons"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_above="@id/camera_mode_tabs"
            android:layout_marginBottom="12dp"
            android:visibility="invisible"
            android:baselineAligned="false">

            <!-- Bottom-anchored, not centred: the third column below now makes this row
                 taller than 96dp, and a centred child would drift upward by half of that
                 growth. Anchoring to the row's bottom edge (which layout_above pins to the
                 mode tabs) with the margin that reproduces the old centre keeps this button
                 exactly where it has always been, whatever the row's height becomes.
                 64dp tall + 16dp margin == the centre of the old 96dp row. -->
            <FrameLayout
                android:id="@+id/flip_camera_circle"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp"
                android:layout_gravity="bottom|center_horizontal">

                <ImageView
                    android:id="@+id/flip_camera_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/circle"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"/>

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/option_circle"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"/>

                <ImageView
                    android:id="@+id/flip_camera_icon_content"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/flip_camera"
                    android:layout_gravity="center"
                    android:contentDescription="@string/flip_camera"/>

                <ImageView
                    android:id="@+id/retake_icon"
                    android:visibility="invisible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/retake"
                    android:layout_gravity="center"
                    android:contentDescription="@string/retake"/>

            </FrameLayout>

            <!-- Same bottom anchoring as the flip button, for the same reason: the capture
                 ring must not move when the third column grows. 84dp tall + 6dp margin ==
                 the centre of the old 96dp row. -->
            <FrameLayout
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="6dp"
                android:layout_gravity="bottom|center_horizontal">

                <ImageButton
                    android:id="@+id/capture_button"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:src="@drawable/camera_shutter"
                    android:background="@drawable/cbutton_bg"
                    android:contentDescription="@string/capture"/>

                <ImageButton
                    android:id="@+id/confirm_button"
                    android:visibility="invisible"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:src="@drawable/done"
                    android:background="@drawable/cbutton_bg"
                    android:contentDescription="@string/confirm"/>

                <!-- Sp usage was ignore because -->
                <TextView
                    android:id="@+id/capture_button_text"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="28dp"
                    android:textStyle="bold"
                    android:textColor="#333"
                    tools:ignore="SpUsage"/>

                <!-- Decoration drawn over the capture button, which announces the cancel itself -->
                <ImageView
                    android:id="@+id/capture_button_cross"
                    android:layout_height="36dp"
                    android:layout_width="36dp"
                    android:src="@drawable/cancel"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:importantForAccessibility="no"/>

                <ImageView
                    android:id="@+id/mic_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/mic_off"
                    android:alpha="0.8"
                    android:visibility="gone"
                    android:contentDescription="@string/rec_without_audio"/>

            </FrameLayout>

            <!-- Third column: the gallery thumbnail, with the Gallery button stacked
                 directly beneath it. The extra height is owned by this column alone — the
                 flip and capture buttons above are bottom-anchored so the row growing
                 upward (its bottom edge is pinned above camera_mode_tabs) leaves them
                 untouched. The `timer` view is layout_below="@id/three_buttons", i.e. it
                 hangs off that same unmoved bottom edge, so it does not collide either. -->
            <LinearLayout
                android:id="@+id/third_column"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

            <!-- Hidden on the idle camera screen. This frame used to be the big gallery
                 circle in the bottom right, and the two Gallery buttons below open
                 that same folder now, so it had become a third way to do what two buttons
                 already do.

                 It is `gone` rather than deleted because opening the gallery was never its
                 only job: while a video is recording it IS the take-a-still shutter, and
                 CaptureActivity / VideoCaptureActivity use this same frame as the
                 preview-and-confirm surface they hand back to whichever app asked for a
                 capture. Those two make it visible themselves;
                 MainActivity.thirdOptionIdleVisibility is what every "put the normal camera
                 UI back" site restores it to. -->
            <FrameLayout
                android:id="@+id/third_option"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/white_option_circle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/white_option_circle"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_preview"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/circle"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                    android:importantForAccessibility="no"/>

                <ImageView
                    android:id="@+id/third_circle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/option_circle"
                    android:layout_gravity="center"
                    android:contentDescription="@string/open_gallery"/>

                <ProgressBar
                    android:indeterminateDrawable="@drawable/progress_bar_style"
                    android:id="@+id/preview_loading"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true"/>

                <ImageView
                    android:id="@+id/play_preview"
                    android:visibility="invisible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/play"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play_preview"/>

            </FrameLayout>

                <!-- The two Gallery buttons. Everything that decides how they look
                     lives in the one shared style, so they differ only by icon, id and
                     description - the point of the pair is that neither reads as the
                     odd one out.

                     Both open the SAME folder today: the camera writes photos and videos
                     into one capture folder, and splitting the destinations is a later
                     change that has to split the folder first. Two buttons onto one
                     folder is deliberate, not a stub. -->
                <ImageButton
                    android:id="@+id/open_cloud_gallery_video"
                    style="@style/Widget.Camera.CloudGalleryButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/videocam"
                    android:tooltipText="@string/open_cloud_gallery_video"
                    android:contentDescription="@string/open_cloud_gallery_video"/>

                <ImageButton
                    android:id="@+id/open_cloud_gallery_photo"
                    style="@style/Widget.Camera.CloudGalleryButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/photo"
                    android:tooltipText="@string/open_cloud_gallery_photo"
                    android:contentDescription="@string/open_cloud_gallery_photo"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoom_bar_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/zoom_in_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/zoom_in"
                android:layout_marginBottom="10dp"
                android:importantForAccessibility="no"/>

            <cld.camera.ui.seekbar.ZoomBar
                android:id="@+id/zoom_bar"
                android:layout_width="wrap_content"
                android:progressTint="@android:color/transparent"
                android:layout_height="250dp"
                android:contentDescription="@string/zoom"/>

            <ImageView
                android:id="@+id/zoom_out_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zoom_out"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="32dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/exposure_bar_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/exposure_plus_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/exposure_plus"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="250dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#99ffffff"/>

                <cld.camera.ui.seekbar.ExposureBar
                    android:id="@+id/exposure_bar"
                    android:layout_width="wrap_content"
                    android:progressTint="@android:color/transparent"
                    android:thumb="@drawable/exposure_thumb"
                    android:layout_height="250dp"
                    android:contentDescription="@string/exposure_compensation"/>

            </FrameLayout>

            <ImageView
                android:id="@+id/exposure_neg_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/exposure_neg"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"/>

        </LinearLayout>

        <!-- #868 the mode switcher: the photo flavours as a page strip above libs:bottomnav's island
             (QR Code | Objects | Camera | Video | VR). It sits at the very bottom, lifted only by the
             navigation-bar inset (MainActivity's insets listener), and main_frame ends at its top edge,
             so the preview never runs under it. cld.camera.ui.ModeNav drives both; this id is what
             three_buttons and the preview's reposition math are anchored to. -->
        <LinearLayout
            android:id="@+id/camera_mode_tabs"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp">

            <com.diegonmarcos.superapp.bottomnav.PageTabsView
                android:id="@+id/camera_mode_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.diegonmarcos.superapp.bottomnav.BottomNavIslandView
                android:id="@+id/camera_mode_island"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:layout_height="26dp"
            android:layout_width="26dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/cancel_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?actionBarItemBackground"
                android:importantForAccessibility="no"
                android:contentDescription="@string/cancel"/>

        </FrameLayout>

        <ImageButton
            android:id="@+id/settings_option"
            android:layout_alignParentTop="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            android:paddingHorizontal="16dp"
            android:background="@null"
            android:src="@drawable/settings_icon"
            android:contentDescription="@string/settings"/>

        <TextView
            android:id="@+id/timer"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="@drawable/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/three_buttons"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:text="@string/start_value_timer"/>

        <LinearLayout
            android:id="@+id/qr_scan_toggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/settings_dialog_padding_horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                    <cld.camera.ui.QRToggle
                        android:id="@+id/qr_scan_toggle"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:layout_gravity="center"
                        android:src="@drawable/qr_code"
                        app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                        android:contentDescription="@string/qr_scan"/>

                    <TextView
                        android:alpha="0.8"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:shadowColor="#000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.3"
                        android:shadowRadius="1.6"
                        android:layout_marginTop="8dp"
                        android:textAlignment="center"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="@string/qr_scan"
                        android:textColor="@android:color/white"
                        android:importantForAccessibility="no"/>

            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                    <cld.camera.ui.QRToggle
                        android:id="@+id/data_matrix_toggle"
                        android:layout_gravity="center"
                        android:src="@drawable/data_matrix"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                        android:contentDescription="@string/data_matrix"/>

                    <TextView
                        android:alpha="0.8"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:shadowColor="#000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.3"
                        android:shadowRadius="1.6"
                        android:textAlignment="center"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="@string/data_matrix"
                        android:textColor="@android:color/white"
                        android:importantForAccessibility="no"/>

            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                    <cld.camera.ui.QRToggle
                        android:id="@+id/aztec_toggle"
                        android:layout_gravity="center"
                        android:src="@drawable/aztec"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                        android:contentDescription="@string/aztec_code"/>

                    <TextView
                        android:alpha="0.8"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:shadowColor="#000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.3"
                        android:shadowRadius="1.6"
                        android:textAlignment="center"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:text="@string/aztec_code"
                        android:textColor="@android:color/white"
                        android:importantForAccessibility="no"/>

            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <cld.camera.ui.QRToggle
                    android:id="@+id/pdf417_toggle"
                    android:layout_gravity="center"
                    android:src="@drawable/pdf417"
                    android:layout_width="@dimen/qr_toggle_button_size"
                    android:layout_height="@dimen/qr_toggle_button_size"
                    app:shapeAppearance="@style/ShapeAppearance.Image.PILL"
                    android:contentDescription="@string/pdf_417"/>

                <TextView
                    android:alpha="0.8"
                    android:layout_width="@dimen/qr_toggle_button_size"
                    android:layout_height="@dimen/qr_toggle_button_size"
                    android:shadowColor="#000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.6"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:text="@string/pdf_417"
                    android:textColor="@android:color/white"
                    android:importantForAccessibility="no"/>

            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/more_options"
                        android:src="@drawable/more_options"
                        android:layout_gravity="center"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:contentDescription="@string/more_options"/>

                    <TextView
                        android:alpha="0.8"
                        android:layout_width="@dimen/qr_toggle_button_size"
                        android:layout_height="@dimen/qr_toggle_button_size"
                        android:layout_marginTop="8dp"
                        android:textAlignment="center"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:shadowColor="#000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.3"
                        android:shadowRadius="1.6"
                        android:text="@string/more_options"
                        android:textColor="@android:color/white"
                        android:importantForAccessibility="no"/>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
