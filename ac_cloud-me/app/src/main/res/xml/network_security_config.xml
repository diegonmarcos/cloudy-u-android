<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud Me reaches cloud-me-api on the mesh first; the cleartext host is generated from the fleet declaration. Everything else is HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- BEGIN fleet-mesh-cleartext (generated from ac_cloud-account/build.json::fleet_endpoints by 1_cicd/src/scripts/cloud-android-fleet-nsc.py; do not edit) -->
        <domain includeSubdomains="false">cloud-me-api.mesh.diegonmarcos.com</domain>
        <!-- END fleet-mesh-cleartext -->
    </domain-config>
</network-security-config>
