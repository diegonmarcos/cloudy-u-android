<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="cld.termux.shared">

    <!-- cloud-shared-store, step 2 (owner answer 41, "1+2"): cloud-drive runs as cld.termux's
         Linux uid (same literal as the terminals: ac_cloud-termux/build.json::shared_store
         .shared_user_id; aa_cloud-superapp/data/fleet-identity.json lists the member), so every
         sync and clone path is a plain File in ~/cloud-shared-store. Every build of this app is
         signed with the one constellation key (app/build.gradle signingConfigs), as the shared uid
         requires. Installing this over an older cloud-drive is refused (uid change): backup
         (automatic on launch of the step-1 build) -> uninstall -> install -> restore. Never add the
         max-sdk exit-hatch attribute here silently: it is documented in
         fleet-identity.json. If the uid is not in effect at runtime, libs:shared-store detects it
         and git runs inside cld.termux through CLOUD_EXEC. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mount keeper (build.json::mount_keeper): a foreground service keeps mounts alive past the UI,
         restored on boot and after an update; the battery exemption keeps Doze/OEM managers from
         killing it; a partial wake lock is held only while a transfer runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The Files tab is a real file manager, so it needs the whole of shared storage. On
         Android 11+ that is the special all-files access MainActivity.requestStorageAccess()
         sends the user to; below it the legacy pair is granted at install time. maxSdkVersion
         keeps the legacy ones from being requested where they no longer mean anything. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- #642 git operations are cloud-terminal-nix's job, and its RunCommandService is guarded
         by this permission (protectionLevel dangerous, so it is also asked for at the point of
         use). ${terminalPackage} is interpolated from the constellation fleet manifest by
         app/build.gradle — the package id is not typed here, or anywhere but build.json's
         fleet id. Without this line the service call is refused with a SecurityException, which
         is exactly the "looked like it worked" failure this feature is built to avoid. -->
    <uses-permission android:name="${terminalPackage}.permission.RUN_COMMAND" />

    <!-- #684 sign-in rides the fleet's own browser: an AUTH MISSION is fired at cloud-browser for
         a result, and its activity is guarded by a SIGNATURE-level permission (fleet apps share
         the one constellation key, so holding it proves this app is fleet). Both names are the
         declared contract (ab_cloud-libs-shared/build.json::auth.browser_mission) with the
         browser's package resolved from the constellation manifest by app/build.gradle. -->
    <uses-permission android:name="${authMissionPermission}" />

    <!-- #1375 USB-C drives over OTG: USB host is used when the phone has it, never required (a phone without it still
         installs the app; the drive features then simply do not appear). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Manage ▸ Apps lists every installed app with its sizes. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <queries>
        <package android:name="com.diegonmarcos.superapp" />
        <package android:name="com.diegonmarcos.clouddrive" />
        <!-- #642 the terminal is resolved by package to tell "not installed" apart from
             "refused": on API 30+ an unqueried package is INVISIBLE, and invisible reads
             exactly like uninstalled. The MAIN/LAUNCHER query below would cover it today,
             but only for as long as the terminal keeps a launcher icon. -->
        <package android:name="${terminalPackage}" />
        <!-- #684 the browser is resolved by package too, so "not installed" and "refused"
             stay two different facts for the auth mission (same rule as the terminal). -->
        <package android:name="${authMissionPackage}" />
        <!-- #705 the gh ENGINE (Cloud-Lib-Gh.apk, build.json::engines.gh): this app binds its
             service instead of compiling gh. Without this line the engine is invisible on
             API 30+, and the GitHub card would say "install it" with it installed. -->
        <package android:name="${ghEnginePackage}" />

        <!-- The Apps tab launches the fleet's data apps (and Tidal) through the system
             launcher. A package query per tile would be a second list of packages to
             keep in step with data/drive-apps.json, so this asks Android the declarative
             question instead: every installed app that offers a launcher MAIN intent is
             reachable, and nothing here names one. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Agents ▸ Screenshots: who may read the agent's results through ScreenshotAgentProvider.
         Signature level: only an app signed with the fleet key (Cloud Tasks' event agent). -->
    <permission
        android:name="${applicationId}.permission.READ_AGENT_RESULTS"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudDrive"
        tools:targetApi="31">

        <!-- #579 the Compose chrome: DriveShell over the fleet's bottom-nav island. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CloudDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- #458/#577: cloud-drive IS the fleet's PDF reader, and the ONE in-process PDF engine
             (#463) lives behind this activity. Any app that hands over application/pdf — cloud-mail's
             attachment chooser above all — reaches the engine through THIS filter and never carries
             a renderer of its own: the way to add a consumer is the manifest, not a copy. The
             Files tab opens its PDF rows here too (DriveActions.openPdf, #579). Exported for the
             chooser; it takes only a data URI (content:// is the sender's grant, file:// is confined
             to places the app already browses) and nothing else from the intent. configChanges keeps
             a rotation from re-opening a large document: the view re-lays itself out on the same
             page instead. -->
        <activity
            android:name=".PdfReaderActivity"
            android:exported="true"
            android:label="@string/open_in_cloud_drive"
            android:theme="@style/Theme.CloudDrive"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/open_in_cloud_drive">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file"    android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- #459/#460 / #579: the image viewer, also the "Open with" target for image/*. -->
        <activity
            android:name=".viewer.ImageViewerActivity"
            android:exported="true"
            android:theme="@style/Theme.CloudDrive">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- #1115 GET_CONTENT / PICK for any type: a web page's file input and an app's "choose a file"
             list the activities with these filters. PickerActivity forwards to the system picker on
             Drive's root (documents.DriveDocumentsProvider) and returns the chosen document. -->
        <activity
            android:name=".documents.PickerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudDrive">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- #567 push 5: the Compose host for the four engine libraries (git manager, full
             editor, rclone, mounts). Started by MainActivity.openEngine for a result; never
             exported. adjustResize so the editor's keyboard does not cover the line being typed. -->
        <activity
            android:name=".EngineActivity"
            android:exported="false"
            android:theme="@style/Theme.CloudDrive"
            android:windowSoftInputMode="adjustResize" />

        <!-- #1375 "Choose an app for the USB device": a USB mass-storage drive (res/xml/device_filter.xml, class 8)
             offers Cloud Drive next to the other file managers. The activity opens Explorer on the drive Android
             mounted, or browses it raw over USB (libaums, FAT32) when Android did not; the USB permission goes
             through libs:perms (PermsUsb). test/test-drive-usb-drives.sh pins every line of this block. -->
        <activity
            android:name=".usb.UsbDriveActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CloudDrive">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- #1375 drives mounting and leaving: the media broadcasts on the file scheme (exempt from the implicit-broadcast
             limits) and the USB detach. They refresh Explorer's places and turn the drive card to "Safe to remove". -->
        <receiver
            android:name=".usb.UsbVolumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_BAD_REMOVAL" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>

        <!-- Open-with and Share hand a file to another app, and a file:// URI has been illegal
             to send across that boundary since Android 7. Everything leaves through here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Mount keeper: started (not only bound) and sticky, so mounts outlive every Activity;
             stopWithTask=false so swiping the app away does not drop them. -->
        <service
            android:name=".mounts.MountKeeperService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's open remote file-system mounts (sftp/ftp/webdav) connected while the app is in the background" />
        </service>

        <receiver
            android:name=".mounts.MountBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />

        <!-- #669 registers the Sync▸Git debug routes (health/git/session/log) on the
             fleet's loopback AppDebugServer (127.0.0.1:38090+, fleet Bearer) before
             Application.onCreate — same init trick as libs:devtools' DebugInitProvider.
             Not exported and not a real provider: onCreate is the whole point. -->
        <provider
            android:name=".debugapi.DriveDebugApiProvider"
            android:authorities="${applicationId}.drivedebugapi"
            android:exported="false" />
        <!-- Agents ▸ Screenshots: the agent's output contract served read-only
             (data/agent-screenshots-contract.json, docs/screenshot-agent-contract.md), and the
             hook that arms its schedule on process start. -->
        <provider
            android:name=".agents.ScreenshotAgentProvider"
            android:authorities="${applicationId}.agents.screenshots"
            android:exported="true"
            android:permission="${applicationId}.permission.READ_AGENT_RESULTS" />

        <!-- #1115 Cloud Drive as a source in the system file picker (ACTION_OPEN_DOCUMENT, which a
             WebView / Chrome file input uses). The framework only lists a provider that is exported,
             answers DOCUMENTS_PROVIDER, grants URI permissions and is guarded by MANAGE_DOCUMENTS
             (held by the system picker alone, so no third app can query it directly). Read-only:
             roots "drive" (the fleet store) and "home" (cld.termux's home, via the shared uid). -->
        <provider
            android:name=".documents.DriveDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
