<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #865 Cloud Store: the constellation store as its own APK. The install
         engine (libs:updater) brings INTERNET, POST_NOTIFICATIONS,
         REQUEST_INSTALL_PACKAGES, UPDATE_PACKAGES_WITHOUT_USER_ACTION and its
         install-result receiver through the manifest merge. What the STORE
         pages add on top is declared here. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Phone tab: Uninstall on a row. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Phone tab: Stop on a row (#859). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Phone tab lists every installed app, and the fleet list reads the
         installed version of every constellation package. Self-signed APK,
         no Play distribution, same as cloud-superapp. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Phone tab: each app's size (app + data + cache) through StorageStatsManager. Special
         access the user grants on the usage-access screen (the row's one-tap Grant), and listed
         on Access > Android Perms; without it the rows show the APK size, labelled APK. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- #1512 No shell channel of its own: silent installs go through the SuperApp's shell broker (libs:shell-client). INTERNET and
         mDNS for the Apps Mesh probes; WRITE_SECURE_SETTINGS can only be held through `pm grant` (the broker runs it) and lets the
         Play Protect switch be written directly; the foreground-service permissions are the batch service's (dataSync). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Configs > Perms asks the owner to leave the Store unrestricted (battery_opt) when auto-update is on. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- #1121 The cross-app start the fleet IPC grants declare: after the Store installs the Termux
         terminal or Nix-on-Droid it starts that app's UnpackService (action
         com.diegonmarcos.cloud.action.UNPACK), guarded by this signature permission. Declared with the
         same definition the terminals and MyTerminal use, so the grant never depends on install order. -->
    <permission
        android:name="com.diegonmarcos.cloud.permission.TERMINAL_SESSION"
        android:label="Cloud terminal sessions"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.diegonmarcos.cloud.permission.TERMINAL_SESSION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudStore"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SuperApp opens a given tab: com.diegonmarcos.cloudstore.OPEN + extra "tab". -->
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudstore.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- #1502 no boot receiver, #1512 no pairing service, keep-alive service or Shizuku provider: the channel is the SuperApp's
             shell broker, reached by a provider call. WorkManager keeps its own persisted jobs across a reboot, and Cloud Store runs a
             background job only with auto-update ON and on an unmetered network (libs:core BackgroundPolicy). -->
        <!-- #903 the dataSync foreground service a running batch (Download all /
             Update all / the auto chain / one row's Install) holds, so Android
             and Samsung's freezer leave the process and its network alone.
             libs:updater declares it too; restated here so this manifest is the
             record of what the app runs, and the merger folds the two. -->
        <service
            android:name="com.diegonmarcos.superapp.updater.BatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- #903 WorkManager's own foreground service runs the download/install
             workers' ForegroundInfo, so it needs the same type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    
        <!-- #1547 The fleet data provider: tiers 3-4 (app defaults, reference data) served at runtime, never baked into an APK. Routes
             app/<pkg>/<dataset>, shared/<dataset>, index; access by callingPackage plus the served manifest; signature permission
             CONSTELLATION_DATA; openFile streams (no Binder size limit). Only openFile does anything. -->
        <provider
            android:name="com.diegonmarcos.superapp.fleetdata.provider.FleetDataProvider"
            android:authorities="cloud.store.data"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
    </application>
</manifest>
