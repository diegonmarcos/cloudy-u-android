  },
  {
   "path": "/__app__/api/served",
   "surface": "app",
   "ipc": [
    "app-launch"
   ],
   "via": "api_served op start_app -> served LAUNCHER (opens a package's launch activity)"
  },
  {
   "path": "/__app__/api/power",
   "surface": "app",
   "ipc": [
    "nix-door"
   ],
   "via": "api_power -> power::apply -> door::sync -> door SENDER (Intent to the nix app's service)"
  },
  {
   "path": "/__app__/api/sshd",
   "surface": "app",
   "ipc": [
    "nix-door"
   ],
   "via": "api_sshd -> door::command -> door::set -> door SENDER (supervised door only; hosted doors are in-process)"
  },
  {
   "path": "/__app__/api/open",
   "surface": "app",
   "ipc": [
    "browser-open"
   ],
   "via": "api_open -> diag::open -> the installed opener (Intent to cloud-browser)"
  },
  {
   "path": "/endpoints/public",
   "surface": "mesh",
   "method": "GET",
   "ipc": null,
   "via": "meshlogs::route: apis::public_page, in-process",
   "mcp_tools": [
    "obs.debug.phone_public"
   ]
  },
  {
   "path": "/endpoints/mesh",
   "surface": "mesh",
   "method": "GET",
   "ipc": null,
   "via": "meshlogs::route: apis::mesh_page, in-process",
   "mcp_tools": [
    "obs.debug.phone_mesh"
   ]
  },
  {
   "path": "/logs",
   "surface": "mesh",
   "method": "GET",
   "ipc": [
    "fleet"
   ],
   "via": "meshlogs::route index: bearer checked against the fleet token (fleet provider); lists apps, no logexport call"
  },
  {
   "path": "/logs/<app>",
   "surface": "mesh",
   "method": "GET",
   "ipc": [
    "fleet",
    "logexport"
   ],
   "via": "meshlogs::route -> LogSource(<package>.logexport, meta|logs|crashes|export)",
   "mcp_tools": [
    "obs.debug.phone_logs"
   ]
  },
  {
   "path": "/browser/status",
   "surface": "mesh",
   "method": "GET",
   "ipc": [
    "fleet",
    "headless"
   ],
   "via": "meshlogs::browser -> LogSource(<browser_package>.<browser_suffix>, status)"
  },
  {
   "path": "/browser/command",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "headless"
   ],
   "via": "meshlogs::browser -> method command"
  },
  {
   "path": "/browser/run",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "headless"
   ],
   "via": "meshlogs::browser -> method run"
  },
  {
   "path": "/browser/stop",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "headless"
   ],
   "via": "meshlogs::browser -> method stop"
  },
  {
   "path": "/browser/cdp",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "headless"
   ],
   "via": "meshlogs::browser -> method cdp_on|cdp_off"
  },
  {
   "path": "/shell/status",
   "surface": "mesh",
   "method": "GET",
   "ipc": [
    "fleet",
    "shellbroker"
   ],
   "via": "meshlogs::shell -> method status"
  },
  {
   "path": "/shell/exec",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "shellbroker"
   ],
   "via": "meshlogs::shell -> method exec_json"
  },
  {
   "path": "/shell/stream",
   "surface": "mesh",
   "method": "POST",
   "ipc": [
    "fleet",
    "shellbroker"
   ],
   "via": "meshlogs::shell -> method stream_json"
  },
  {
   "path": "/__api__/diag/about",
   "surface": "diag",
   "method": "GET",
   "ipc": [
    "fleetdiag"
   ],
   "via": "lib::handle_diag -> diag::answer -> SOURCE (<superapp>.fleetdiag provider)"
  },
  {
   "path": "/__api__/diag/logcat",
   "surface": "diag",
   "method": "GET",
   "ipc": [
    "fleetdiag"
   ],
   "via": "lib::handle_diag -> diag::answer -> SOURCE (<superapp>.fleetdiag provider)"
  },
  {
   "path": "/__api__/diag/diagnose",
   "surface": "diag",
   "method": "GET",
   "ipc": [
    "fleetdiag"
   ],
   "via": "lib::handle_diag -> diag::answer -> SOURCE (<superapp>.fleetdiag provider)"
  },
  {
   "path": "/__api__/health",
   "surface": "diag",
   "method": "GET",
   "ipc": null,
   "via": "lib::handle_diag, in-process"
  },
  {
   "path": "/__api__/serving",
