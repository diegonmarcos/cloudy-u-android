<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenRouter only (the router, the workers, the key test, the catalogue's prices), over
         libs:decisions' UrlHttp on Android's resolver so the SuperApp's DNS menu applies. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sensors (#1538): the grants are Configs > Perms rows only (build.json::perms.needs); nothing here asks. Scans run on tap, with a timeout. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Cloud Account (Profile) and Cloud Store (Store section) are opened by package-pinned intents. -->
    <queries>
        <package android:name="com.diegonmarcos.cloudaccount" />
        <package android:name="com.diegonmarcos.cloudstore" />
        <!-- #1538 the Connected catalogue asks whether the ANT+ radio service and Health Connect are installed -->
        <package android:name="com.dsi.ant.service.socket" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudToolsSmallLlms"
        tools:targetApi="31">

        <!-- allowBackup is off: the token's EncryptedSharedPreferences cannot be restored on another
             device (its Keystore key never leaves this one); fleet setup migrates it instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudToolsSmallLlms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share > Tools of plain text lands in the chat box. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
