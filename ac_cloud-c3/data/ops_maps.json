  "viewers": {
    "_doc": "#1955 A Table|Graph on every Ops > Network subpage. pages.<id>.graph is the ONLY source of what the graph may draw: rows of the bound map/tree/mesh, their edges, and the roots/depends declared here. NetGraph builds, NetGraphLayout places (no x/y is typed), NetLive colours from existing API answers and device probes only; a node with no live binding is grey 'declared'.",
    "modes": [
      "table",
      "graph"
    ],
    "default": "table",
    "_doc_rev2": "#1955 A rev2 (no-overlap): world units are dp, the world is 412 wide (12 margin + 388 content). Standard node 104 x 32 (three across with gap 38), frame header band 22, inner padding 8, 12 between frames. scene: semantic zoom tiers (FAR below far_below, NEAR from near_from), fixed text sizes in sp, character caps, label budgets, the caption strip, minimap and placer numbers. Canvas text sits in a reserved box at a fixed size or is not drawn; wires carry no text unless selected or at NEAR.",
    "node_w": 104,
    "node_h": 32,
    "gap_x": 38,
    "gap_y": 12,
    "lane_header": 22,
    "frame_pad": 8,
    "frame_gap": 12,
    "collapse_over": 9,
    "fit_all_pages": [],
    "scene": {
      "far_below": 0.6,
      "near_from": 1.4,
      "name_sp": 12,
      "metric_sp": 10,
      "header_sp": 10,
      "caption_sp": 10,
      "pill_sp": 10,
      "caption_h": 18,
      "shape": 10,
      "pad": 6,
      "pad_r": 10,
      "pad_v": 2,
      "cap_name": 12,
      "cap_name_wide": 18,
      "cap_name_near": 24,
      "cap_metric": 28,
      "cap_pill": 14,
      "cap_anchor": 10,
      "cap_header": 40,
      "cap_caption": 12,
      "wide_from": 140,
      "max_names": 40,
      "max_pills": 12,
      "max_pills_selected": 8,
      "max_anchors": 12,
      "pill_pad": 6,
      "pill_h": 18,
      "obstacle_pad": 4,
      "root_pad": 6,
      "wire_clear": 10,
      "wire_sample": 12,
      "minimap_w": 72,
      "minimap_h_min": 48,
      "minimap_h_max": 96,
      "minimap_inset": 8,
      "header_inset": 6
    },
    "bundle_min": 3,
    "pulse_max_edges": 40,
    "live_ttl_s": 60,
    "status": {
      "handshake_ok_s": 180,
      "handshake_warn_s": 900,
      "stale_is": {
        "hub": "down",
        "spoke": "down",
        "client": "unknown"
      }
    },
    "pages": {
      "net_wg": {
        "graph": {
          "from": "map",
          "map": "wg",
          "columns": [
            "Clients",
            "Hubs",
            "Fleet VMs"
          ],
          "lanes": [
            {
              "id": "mesh",
              "label": "Mesh"
            },
            {
              "id": "transport",
              "label": "Transports and planned"
            }
          ],
          "resolve": [
            "vm_id_to_alias"
          ],
          "sections": [
            {
              "match": "Subnets: hub and peers",
              "ns": "host",
              "lane": "mesh",
              "column_by": {
                "note_has": {
                  "client": 0,
                  "hub": 1,
                  "spoke": 2
                }
              },
              "targets": [
                "host"
              ],
              "target_ns": "host",
              "edge_kind": "wg_tunnel",
              "dep": "from_needs_to",
              "bind": [
                "vm",
                "tunnel"
              ],
              "layer_by": "edge_label"
            },
            {
              "match": "Transports",
              "ns": "transport",
              "lane": "transport",
              "column": 1,
              "targets": [
                "host"
              ],
              "edge_kind": "transport",
              "dep": "none"
            },
            {
              "match": "Planned",
              "ns": "planned",
              "lane": "transport",
              "column": 0,
              "targets": [
                "transport",
                "host"
              ],
              "edge_kind": "planned",
              "dep": "none"
            }
          ]
        }
      },
      "net_auth": {
        "graph": {
          "from": "map",
          "map": "auth",
          "columns": [
            "Gates",
            "Tiers and kinds",
            "Protected"
          ],
          "lanes": [
            {
              "id": "edge",
              "label": "Edge"
            },
            {
              "id": "containers",
              "label": "Containers"
            }
          ],
          "sections": [
            {
              "match": "Edge tier of each route",
              "ns": "tier",
              "lane": "edge",
              "column": 1,
              "target_ns": "host",
              "target_column": 2,
              "cluster_targets": true,
              "edge_kind": "tier_member",
              "dep": "to_needs_from",
              "target_bind": [
                "host"
              ]
            },
            {
              "match": "Auth kind of each container",
              "ns": "authkind",
              "lane": "containers",
              "column": 1,
              "target_ns": "container",
              "target_column": 2,
              "cluster_targets": true,
              "edge_kind": "kind_member",
              "dep": "to_needs_from",
              "target_bind": [
                "container"
              ]
            },
            {
              "match": "Gates",
              "ns": "gate",
              "lane_by_target": true,
              "column": 0,
              "targets": [
                "tier",
                "authkind",
                "container"
              ],
              "edge_kind": "auth_forward",
              "dep": "to_needs_from",
              "bind_rows": {
                "Authelia": "container:authelia"
              }
            }
          ]
        }
      },
      "net_dns": {
        "collapse_over": 4,
        "graph": {
          "from": "map",
          "map": "dns",
          "columns": [
            "Public hosts",
            "Service",
            "Mesh names",
            "Address"
          ],
          "lanes": {
            "by": "vm"
          },
          "resolve": [
            "vm_id_to_alias"
          ],
          "cluster_by": "lane_column",
          "sections": [
            {
              "match": "Caddy routes by VM",
              "ns": "host",
              "column": 0,
              "lane_from": "edge_label",
              "target_ns": "service",
              "target_column": 1,
              "edge_kind": "reverse_proxy",
              "dep": "from_needs_to",
              "bind": [
                "host"
              ],
              "target_bind": [
                "container"
              ]
            },
            {
              "match": "Mesh DNS",
              "ns": "meshname",
              "column": 2,
              "lane_from": "edge_to",
              "target_ns": "address",
              "target_column": 3,
              "edge_kind": "dns_a",
              "dep": "from_needs_to",
              "bind": [
                "host"
              ],
              "target_bind": [
                "vm"
              ]
            }
          ],
          "depends": [
            {
              "id": "dep:mesh-dns-primary",
              "from_section": "Mesh DNS",
              "on": "address:{infra.dns.primary}",
              "label": "resolved by"
            }
          ]
        }
      },
      "net_network": {
        "graph": {
          "from": "topology",
          "view": "network",
          "columns": [
            "Subnet",
            "Peer",
            "Group",
            "Route or rule",
            "Container"
          ],
          "lanes": {
            "by": "root"
          },
          "open_depth": 2,
          "cluster_kind": "group",
          "edge_label": {
            "peer": "peer",
            "group": "",
            "route": "route",
            "container": "upstream",
            "rule": "rule"
          },
          "dep": "to_needs_from",
          "bind_keys": {
            "vm": "vm",
            "container": "container"
          },
          "bind_kind": {
            "route": "host"
          }
        }
      },
      "net_security": {
        "graph": {
          "from": "map",
          "map": "hier_net_security",
          "columns": [
            "Page",
            "Server",
            "Route or tool"
          ],
          "root": {
            "id": "root:security",
            "label": "Security",
            "bind": [
              "api:self"
            ]
          },
          "sections": [
            {
              "match": "cloudy-c3-api routes",
              "ns": "route",
              "root": {
                "id": "server:cloudy-c3-api",
                "label": "cloudy-c3-api",
                "bind": [
                  "container:c3-infra-api",
                  "api:self"
                ]
              },
              "root_edge": "calls",
              "row_edge": "serves",
              "column": 2,
              "dep": "to_needs_from"
            },
            {
              "match": "cloudy-c3-mcp tools",
              "ns": "tool",
              "root": {
                "id": "server:cloudy-c3-mcp",
                "label": "cloudy-c3-mcp",
                "bind": [
                  "container:cloud-infra-mcp"
                ]
              },
              "root_edge": "calls",
              "row_edge": "serves",
              "column": 2,
              "dep": "to_needs_from"
            }
          ]
        }
      },
      "net_mesh": {
        "graph": {
          "from": "mesh",
          "columns": [
            "Hub",
            "Spokes",
            "Clients"
          ],
          "lanes": {
            "by": "transport"
          },
          "column_by": {
            "role": {
              "hub": 0,
              "spoke": 1,
              "client": 2
            }
          },
          "edges": {
            "peers": {
              "kind": "wg_peering",
              "label": "allowed_ips",
              "duplex_offset": 6,
              "dep": "none"
            },
            "routes": {
              "kind": "mesh_route",
              "label": "{dst_subnet} via {via_transport}"
            }
          },
          "depends": [
            {
              "id": "dep:spoke-hub",
              "from_role": "spoke",
              "on_role": "hub",
              "label": "reaches the mesh through"
            }
          ],
          "bind": [
            "vm",
            "tunnel"
          ]
        }
      }
    }
  }
}
