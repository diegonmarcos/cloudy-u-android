        },
        {
          "title": "MX hosts",
          "from": "mail_mx"
        },
        {
          "title": "DNS records",
          "from": "mail_dns"
        }
      ]
    },
    "flow": {
      "summary": "CI/CD to Infra to Release: a push starts the workflows, the build feeds the release assets and the fleet manifest, and the deploy lands them on the VMs.",
      "sections": [
        {
          "title": "CI/CD",
          "rows": [
            {
              "name": "Push to main",
              "edges": [
                {
                  "to": "GHA workflows",
                  "label": "paths filter"
                }
              ]
            },
            {
              "name": "GHA workflows",
              "note": "Ship, guards, generated-up-to-date",
              "edges": [
                {
                  "to": "Build",
                  "label": "ship job"
                },
                {
                  "to": "gen-configs",
                  "label": "config change"
                }
              ]
            },
            {
              "name": "Build",
              "note": "Gradle in CI only",
              "edges": [
                {
                  "to": "Release assets",
                  "label": "APK"
                }
              ]
            }
          ]
        },
        {
          "title": "Infra",
          "rows": [
            {
              "name": "gen-configs",
              "note": "regenerates dist from the declarations",
              "edges": [
                {
                  "to": "Fleet manifest",
                  "label": "commit dist"
                }
              ]
            },
            {
              "name": "Fleet manifest",
              "note": "fleet-manifest-guard, fleet-refresh",
              "edges": [
                {
                  "to": "VM deploy",
                  "label": "declared state"
                }
              ]
            }
          ]
        },
        {
          "title": "Release",
          "rows": [
            {
              "name": "Release assets",
              "note": "GHCR via ORAS, GitHub Release",
              "edges": [
                {
                  "to": "Fleet manifest",
                  "label": "version pin"
                }
              ]
            },
            {
              "name": "VM deploy",
              "note": "ship-home-manager per VM, then docker compose",
              "edges": [
                {
                  "to": "Health",
                  "label": "docker ps and uptime"
                }
              ]
            }
          ]
        }
      ]
    },
