            }
          ]
        },
        {
          "title": "Containers",
          "from": "containers",
          "names": [
            "maddy",
            "stalwart",
            "stalwart-sorter",
            "mail-puller",
            "cloud-webmail",
            "cloud-mail-mcp",
            "auth-broker-email",
