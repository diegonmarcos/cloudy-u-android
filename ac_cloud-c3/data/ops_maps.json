{
  "_doc": "#1480 Cloud-C3 Ops maps: Network (wg, auth, dns), Mail and the Orchestration flow, drawn from nodes and edges. A section with `from` is DERIVED at run time from the fleet's own data (mesh.json, infra_slice.json, containers_declared.json, fleet_slice.json), never copied here; a section with `rows` is the few facts no derived file holds (a planned channel, a path between named containers, the CI/CD stages). Row = name, note, state (planned | fallback | unverified | blank), edges (to, label, state). Secret values never appear: only names. #1495: the maps.hier_* entries are GENERATED by gen_c3_hierarchy.py (the catalog pages of the one hierarchy); never edit them.",
  "edge_cap": 14,
  "auth_kinds": {
    "two_factor": "Authelia SSO + 2FA behind Caddy forward_auth",
    "none": "no gate at the edge",
    "bypass": "gate bypassed on purpose",
    "ntfy-3tier": "ntfy three-tier access",
    "mesh": "mesh only, no public route",
    "woauth": "OAuth for MCP clients",
    "bearer": "fleet bearer token",
    "open": "no auth of its own"
  },
  "mail_dns_groups": [
    "MX",
    "SPF",
    "DKIM",
    "DMARC",
    "MTA-STS",
    "TLS-RPT"
  ],
  "logs": {
    "levels": [
      "info",
      "warn",
      "error"
    ],
    "limit": 100
  },
  "maps": {
    "wg": {
