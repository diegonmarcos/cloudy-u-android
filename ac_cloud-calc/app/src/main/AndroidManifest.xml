<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network permission of its own: calculations cross to Cloud-Lib-Calc over a binder
         and only that engine downloads currency rates. (libs:devtools merges in the INTERNET its
         loopback debug server needs.) No self-update either: the Store updates this app. -->
    <!-- The Sound tools only; requested at runtime by ui/SoundScreens.kt's MicGate when a
         listening sound mode opens (#772). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- #772 the Camera tools only; requested at runtime by ui/CameraScreens.kt's CameraGate when
         a photo-taking camera mode opens. A phone without a camera still installs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Jev attachments, Camera and Listen: the camera and the microphone are asked for at use, through CameraGate and
         MicGate, after the screen says why. Files and Images use the system document and photo pickers, which need no
         storage or media permission. -->

    <!-- #768 the Clock tab. Alarms are AlarmManager alarm CLOCKS and every other wakeup is exact:
         SCHEDULE_EXACT_ALARM is the user-granted path on API 31/32, USE_EXACT_ALARM the
         alarm-clock app's own on 33+ (granted at install). Boot re-plans them (a reboot clears
         them all); the foreground service keeps running timers, the stopwatch and rings alive with
         the app closed; full-screen intent puts a ring over the lock screen. POST_NOTIFICATIONS is
         asked for in ui/ClockScreens.kt alone, when something that needs it is started. No
         network: time zones are the device's tzdata. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Measure > Sensors (build.json::sensors). Each runtime permission is requested only when the tapped card says why and the
         user taps Allow (ui/SensorScreens.kt): location for GPS / GNSS, activity recognition for the step counter and detector,
         body sensors for heart rate. Wi-Fi and network state are normal permissions (signal strength; no SSID or location is read);
         NFC only tells whether the adapter is on. A phone without any of these still installs the app. -->
    <!-- #1550 libs:bluetooth declares ACCESS_FINE_LOCATION with maxSdkVersion=30; strip that cap from the merged manifest so
         precise location is requestable on API 31+ (owner SM-A376B / API 36 was stuck on Approximate). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <!-- The calc ENGINE (build.json::engines.calc): without this line it is invisible on
             API 30+ and Calc would say "install it" with it installed. -->
        <package android:name="${calcEnginePackage}" />
        <!-- Toolkit > Tracker: Cloud Navigation, so its launch intent is visible on API 30+ (build.json::ui.modes[tracker]). -->
        <package android:name="${trackerPackage}" />
        <!-- Jev's Listen (speech-to-text): without this line the system recognizer is invisible on API 30+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudCalc"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudCalc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- #772 ARCore is OPTIONAL: the AR measure route is offered only where ARCore runs; every
             other phone measures on a photo against a reference object. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- #772 the AR measure route (ARCore session + GL camera background). -->
        <activity
            android:name=".camera.ArMeasureActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.CloudCalc" />

        <!-- #768 a ring, over the lock screen (the ring notification's full-screen intent). -->
        <activity
            android:name=".clock.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CloudCalc"
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- specialUse is Fossify Clock's type for the same job: no standard type covers "an alarm
             clock's timers and stopwatch keep counting with the app closed". -->
        <service
            android:name=".clock.ClockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Alarm clock: running countdown timers, stopwatch, interval and sleep timers, and ringing alarms, kept alive and controllable while the app is closed" />
        </service>

        <!-- The app's own wakeups and notification buttons: never exported. -->
        <receiver
            android:name=".clock.ClockReceiver"
            android:exported="false" />

        <!-- Everything that clears or shifts AlarmManager alarms re-plans them from the store. -->
        <receiver
            android:name=".clock.ClockBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Toolkit > Voice Recorder: Share hands a recording to another app (Cloud Drive, Mail, Chat) as a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Registers /api/calc/* on the fleet debug server. Not exported, not a real provider. -->
        <provider
            android:name=".debugapi.CalcDebugApiProvider"
            android:authorities="${applicationId}.calcdebugapi"
            android:exported="false" />
    </application>
</manifest>
