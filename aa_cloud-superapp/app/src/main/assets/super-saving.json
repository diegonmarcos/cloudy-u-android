{
  "_doc": "#1506 Super Saving Battery Mode: the most aggressive battery mode, as an ORDERED list of reversible steps (read by bgpolicy/SuperSaving). Before a step changes anything its prior value is read and kept in the snapshot, so Off puts every step back in reverse order, exactly. adb:true = the step needs the privileged shell and is skipped with a note when it is not connected. kinds: bg_policy (restrict every non-essential app, fleet included; Off restores the captured prior states of the apps this run restricted); setting (items of {ns,key,value}: settings put, prior read with settings get, a key that was unset is deleted on Off; skip_if_unset skips a key this device does not have); setting_cap (lower a value to max, never raise it); shell_toggle (read + read_re = prior value, apply, revert_by_old[prior], skip_if_old = nothing to do, require_cmd must print something, skip_if_cmd must print nothing or 0); sync (the master auto-sync switch, no shell); idle_screen_off (cmd deviceidle force-idle on screen-off and unforce on screen-on, a registered receiver while the mode is on, no polling); keeper (stop the wireless-debug keeper unless an ADB step was applied, because Off needs the shell); fleet_stop (am force-stop the fleet's own background engines). Each step writes an audit entry.",
  "indicator": { "title": "Super Saving Battery Mode is on", "text": "Tap Off to restore everything exactly as it was.", "off": "Off" },
  "steps": [
    { "id": "bg_policy", "label": "Background policy: restrict every non-essential app (fleet included)", "kind": "bg_policy", "adb": true },
    { "id": "battery_saver", "label": "System battery saver on", "kind": "setting", "adb": true,
      "items": [ { "ns": "global", "key": "low_power", "value": "1" } ] },
    { "id": "adaptive_battery", "label": "Adaptive battery on", "kind": "setting", "adb": true,
      "items": [ { "ns": "global", "key": "adaptive_battery_management_enabled", "value": "1" } ] },
    { "id": "idle_screen_off", "label": "Doze: force deep idle whenever the screen is off", "kind": "idle_screen_off", "adb": true },
    { "id": "wifi_scan", "label": "Wi-Fi scanning off", "kind": "setting", "adb": true,
      "items": [ { "ns": "global", "key": "wifi_scan_always_enabled", "value": "0" } ] },
    { "id": "ble_scan", "label": "Bluetooth LE scanning off", "kind": "setting", "adb": true,
      "items": [ { "ns": "global", "key": "ble_scan_always_enabled", "value": "0" } ] },
    { "id": "location", "label": "Location off", "kind": "setting", "adb": true, "optional": true,
      "items": [ { "ns": "secure", "key": "location_mode", "value": "0" } ] },
    { "id": "nfc", "label": "NFC off", "kind": "shell_toggle", "adb": true,
      "read": "dumpsys nfc | grep -m1 -o 'mState=[a-z_]*'", "read_re": "mState=([a-z_]+)",
      "apply": "svc nfc disable", "skip_if_old": ["off", "turning_off"],
      "revert_by_old": { "on": "svc nfc enable", "turning_on": "svc nfc enable" }, "verify": ["off", "turning_off"] },
    { "id": "bluetooth", "label": "Bluetooth off unless a device is connected", "kind": "shell_toggle", "adb": true,
      "skip_if_cmd": "dumpsys bluetooth_manager | grep -ciE 'connected: *true|state: *connected|STATE_CONNECTED'", "skip_note": "a Bluetooth device is connected, left on",
      "read": "settings get global bluetooth_on", "read_re": "^([01])", "apply": "svc bluetooth disable", "skip_if_old": ["0"], "verify": ["0"],
      "revert_by_old": { "1": "svc bluetooth enable" } },
    { "id": "mobile_data", "label": "Mobile data off while on Wi-Fi (optional)", "kind": "shell_toggle", "adb": true, "optional": true,
      "require_cmd": "ip route get 1.1.1.1 2>/dev/null | grep -o 'dev wlan'", "skip_note": "not on Wi-Fi, mobile data left on",
      "read": "settings get global mobile_data", "read_re": "^([01])", "apply": "svc data disable", "skip_if_old": ["0"], "verify": ["0"],
      "revert_by_old": { "1": "svc data enable" } },
    { "id": "network_type", "label": "5G to LTE preferred, if available (optional)", "kind": "setting", "adb": true, "optional": true,
      "items": [ { "ns": "global", "key": "preferred_network_mode", "value": "9", "skip_if_unset": true } ] },
    { "id": "sync", "label": "Auto-sync off", "kind": "sync", "adb": false },
    { "id": "refresh_rate", "label": "Lowest refresh rate (60 Hz)", "kind": "setting", "adb": true,
      "items": [ { "ns": "system", "key": "peak_refresh_rate", "value": "60" }, { "ns": "system", "key": "min_refresh_rate", "value": "60" } ] },
    { "id": "brightness_auto", "label": "Automatic brightness, dimmer", "kind": "setting", "adb": true,
      "items": [ { "ns": "system", "key": "screen_brightness_mode", "value": "1" }, { "ns": "system", "key": "screen_auto_brightness_adj", "value": "-0.5" } ] },
    { "id": "brightness_cap", "label": "Brightness capped (never raised)", "kind": "setting_cap", "adb": true,
      "ns": "system", "key": "screen_brightness", "max": 80 },
    { "id": "screen_timeout", "label": "Screen timeout 15 s", "kind": "setting", "adb": true,
      "items": [ { "ns": "system", "key": "screen_off_timeout", "value": "15000" } ] },
    { "id": "dark_mode", "label": "Dark mode on", "kind": "shell_toggle", "adb": true,
      "read": "cmd uimode night", "read_re": "Night mode: ([a-z]+)", "apply": "cmd uimode night yes", "skip_if_old": ["yes"], "verify": ["yes"],
      "revert_by_old": { "no": "cmd uimode night no", "auto": "cmd uimode night auto" } },
    { "id": "aod_doze", "label": "Always-on display off", "kind": "setting", "adb": true,
      "items": [ { "ns": "secure", "key": "doze_always_on", "value": "0", "skip_if_unset": true } ] },
    { "id": "aod_samsung", "label": "Always-on display off (Samsung)", "kind": "setting", "adb": true,
      "items": [ { "ns": "system", "key": "aod_mode", "value": "0", "skip_if_unset": true } ] },
    { "id": "animations", "label": "Animations off (window, transition, animator scale 0)", "kind": "setting", "adb": true,
      "items": [ { "ns": "global", "key": "window_animation_scale", "value": "0" }, { "ns": "global", "key": "transition_animation_scale", "value": "0" },
                 { "ns": "global", "key": "animator_duration_scale", "value": "0" } ] },
    { "id": "keeper", "label": "Fleet: stop the wireless-debug keeper unless this mode still needs the shell", "kind": "keeper", "adb": false },
    { "id": "fleet_stop", "label": "Fleet: stop the Webserver, Headless and terminal engines", "kind": "fleet_stop", "adb": true,
      "packages": [ "com.diegonmarcos.cloudwebserver", "com.diegonmarcos.cloudc3", "cld.termux", "cld.termux.nix", "cld.termux.nix.boot", "com.diegonmarcos.ide" ] }
  ]
}
