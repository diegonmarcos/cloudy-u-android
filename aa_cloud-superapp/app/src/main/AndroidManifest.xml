<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for JMAP / CloudData fetch / GHCR in-app updater. -->
    <!-- Privileged plane (Shizuku-independent): re-enable Wireless Debugging on boot
         and autoconnect the embedded adb client. WRITE_SECURE_SETTINGS is a signature
         perm: never a dialog, granted once by the plane itself via pm grant. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptics.tap / Vibrator.vibrate() in ui/Haptics.kt — without this,
         v.vibrate() throws SecurityException which fire() swallows via
         runCatching, so the "Vibration on tap" toggle silently no-ops.
         performHapticFeedback alone is unreliable (OEMs ship it OFF). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Health badge + Health Connect grants. Declared here as well as in libs:health so THIS manifest is
         self-describing: Health Connect only lists an app that declares the permission it is asked for. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- Read-only Wi-Fi state for the About page: SSID/BSSID need both
         this AND ACCESS_FINE_LOCATION (Android 10+ scoped Wi-Fi info);
         link speed / frequency / RSSI come from the same surface. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Self-created WiFi for pairing (LocalHotspot.kt / Permissions "⓪ Create
         local WiFi"): WifiManager.startLocalOnlyHotspot() needs this to spin
         up a device-local AP when there's no external network to join for
         Wireless Debugging. ACCESS_FINE_LOCATION (declared below) is also
         required by the platform for hotspot creation. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi Direct fallback for pairing (WifiDirect.kt / Permissions "⓪b
         Create WiFi Direct"): WifiP2pManager.createGroup() on API 33+ needs
         this in place of location to discover/create a P2P group. Declared
         neverForLocation since this app never derives physical location from
         it — harmless below API 33 where the fine-location perm gates it
         instead. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />


    <!-- Surface area for Config → About → Permissions. Each row shows
         GRANTED / DENIED state at runtime; the user grants/revokes via
         system settings (Notifications has an in-app button that fires
         the standard request flow on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Long-press → Uninstall, via PackageInstaller.uninstall (shows the
         system confirm dialog). Normal permission, auto-granted on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Silent self-update: the fleet updater installs new APKs without a
         prompt (USER_ACTION_NOT_REQUIRED) once the user grants "Install unknown
         apps" (Configs/About → Permissions → Auto-update). Falls back to a
         prompt when the grant is absent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- THE permission that makes USER_ACTION_NOT_REQUIRED actually silent on
         Android 12+ (API 31). Without it the platform IGNORES the no-user-action
         flag and forces the confirm dialog every time — the "Android warnings"
         seen on auto-update. Normal permission, auto-granted at install. Silent
         still requires this app to be the installer-of-record of the target
         (it becomes so the first time it installs/updates that app). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Floating Top Nav Bar overlay (FloatingNavService). SYSTEM_ALERT_WINDOW
         ("Display over other apps") is a Special-access perm — NOT runtime-
         grantable; the user toggles it in Settings → Special access → Display
         over other apps (the Configs → About → Permissions page surfaces a row
         + a "Set Display-over-apps" deep-link button). The overlay runs in a
         foreground service so Android keeps it alive while the user roams other
         apps; FOREGROUND_SERVICE_SPECIAL_USE is the API-34 type for a launcher-
         companion overlay that doesn't fit camera/location/etc. categories. -->
    <!-- DND toggle from the notification "Do Not Disturb" action. The user
         additionally grants Notification-policy access in Settings; this
         declares the app is allowed to change the interruption filter. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- WRITE_SETTINGS — Configs → Launcher → Others → Screen brightness sets
         device-wide Settings.System.SCREEN_BRIGHTNESS. signature|appop perm:
         declaring it lists the app in Settings → Special access → Modify system
         settings; the slider routes the user there via ACTION_MANAGE_WRITE_SETTINGS
         when not yet granted. tools:ignore suppresses the protected-perm lint
         (same pattern as DUMP / PACKAGE_USAGE_STATS). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION + FOREGROUND_SERVICE +
         FOREGROUND_SERVICE_LOCATION + WAKE_LOCK + the
         LocationTrackerService declaration live in
         libs/maps/src/main/AndroidManifest.xml. Manifest-merger folds
         them into the final APK manifest at assembly time; app/ stays
         free of Maps-specific entries. -->

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- PACKAGE_USAGE_STATS is a "signature|appop" permission: regular
         apps can't be auto-granted by the runtime-permission dialog, but
         declaring it is what makes the app *appear in* Settings → Apps
         → Special access → Usage access (otherwise the picker filters
         us out, regardless of Play-Store vs. sideload). Once it's there
         the user toggles it on, and UsageStatsManager.queryUsageStats
         starts returning real data for the Battery & Usage screen.
         tools:ignore suppresses the lint warning about declaring a
         protected permission — that's exactly what we want here. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- MANAGE_EXTERNAL_STORAGE (API 30+, "All files access") is a
         Special Access permission, NOT a runtime perm — declaring it
         here is what makes the app *appear in* Settings → Special
         access → All files access (otherwise the picker filters us
         out, regardless of how many intents we fire). The user grants
         via the "Grant Files Access" button which jumps to
         ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION. Self-signed APK
         (no Play distribution), so the Play-Store policy gate on this
         permission does not apply; tools:ignore suppresses the lint
         warning for the same reason as PACKAGE_USAGE_STATS above. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- DUMP — signature|privileged perm required to invoke `dumpsys`
         from a regular app. We use `dumpsys battery` to read the
         negotiated max charger current/voltage (BatteryChargerSpec)
         since BatteryManager doesn't expose charger input wattage via
         the public API. Auto-granted to platform-signed apps; for our
         debuggable APK the user grants it once via
             adb shell pm grant com.diegonmarcos.superapp android.permission.DUMP
         tools:ignore suppresses the lint warning about declaring a
         protected permission, same pattern as PACKAGE_USAGE_STATS /
         MANAGE_EXTERNAL_STORAGE above. -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- QUERY_ALL_PACKAGES is the launcher's app-discovery permission.
         Self-signed APK (no Play distribution) so the usual Play Store
         policy gate on this permission does not apply; declaring it
         here grants LauncherApps + PackageManager full visibility over
         every installed launchable activity — the SuperApp needs that
         to act as a Home / Launcher replacement and render the app
         drawer for the Cloud Minimalist Black theme. -->
    <!-- Centauri's inner ring: "Close All" / "Kill Bg" stop the background
         work of the recent apps. Normal permission, granted at install. It
         cannot remove their Overview cards - no public API does. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Configs ▸ Fleet ▸ Agents reads Cloud Drive's Screenshot agent state
         (content://com.diegonmarcos.clouddrive.agents.screenshots/state), the
         read-only provider ac_cloud-drive/data/agent-screenshots-contract.json
         declares. Signature-level: granted because both APKs carry the fleet key. -->
    <uses-permission android:name="com.diegonmarcos.clouddrive.permission.READ_AGENT_RESULTS" />

    <!-- READ_LOGS — Configs → Observability → Logcat, "All Apps" / "Select a App".
         Android hands an unprivileged app only its OWN log lines, which made
         the log viewer able to see everything except the app you are usually
         debugging. This permission is signature|privileged|DEVELOPMENT, and it
         is the `development` flag that matters: the system refuses it at
         install time, but `pm grant` from a shell hands it over and the grant
         PERSISTS. So it is declared here (pm grant refuses a permission the
         package never requested) and granted once from the Logcat section
         through whichever shell channel is up — Shizuku or paired adb. After
         that the app reads the full buffer in its own process with Shizuku
         stopped. Same mechanism the app already uses for DUMP. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Superapp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="false"
        android:directBootAware="false"
        tools:replace="android:name,android:label,android:icon,android:roundIcon,android:allowBackup,android:defaultToDeviceProtectedStorage,android:directBootAware">
        <!-- WorkManager on-demand initialization. Remove the default
             WorkManagerInitializer and provide config via App : Configuration.Provider
             so the first getInstance() lazily initializes it. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- Quick-action handler for the persistent "Cloud SA - KDE" notification. -->
        <!-- extapp: install progress notification actions (Cancel / Retry / Restart / Open). -->
        <receiver
            android:name=".extinstall.ExtInstallActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".system.PrivilegedPlaneBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- #1120 after a reboot the mesh comes back (unless Connect on boot is off); the supervisor then
             reconnects until the owner taps Disconnect. -->
        <receiver
            android:name=".network.MeshBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- #1120 the Reconnect button of the mesh-down alert. Our own PendingIntent only. -->
        <receiver
            android:name=".notificationcenter.MeshDownAlert$ReconnectReceiver"
            android:exported="false" />
        <receiver
            android:name=".notificationcenter.KdeQuickActionReceiver"
            android:exported="false" />
        <!-- #515 — the declared restart path for every PERSISTENT badge in
             build.json::ui.notification_center.

             Android kills this package's services on replace and sends no
             BOOT_COMPLETED for an update. Without this receiver the only badge
             that came back was the one whose service App.onCreate happened to
             start by hand (KDE); Quickmarks, Media and Alerts — all three owned
             by FloatingNavService — stayed dead until the owner opened the
             shell or toggled the overlay.

             exported=true is required: both actions are delivered by the
             system, from outside this package. -->
        <!-- #777 the fleet alerts collector: every Cloud app raises its alerts
             here through libs:core FleetAlerts (a provider call starts this
             process when it is not running, and answers synchronously so the
             caller can fall back). CONSTELLATION_DATA is the fleet's signature
             permission: only an APK signed with the fleet key gets in. -->
        <provider
            android:name=".notificationcenter.FleetAlertsProvider"
            android:authorities="${applicationId}.fleetalerts"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
        <!-- #866 the fleet bearer, read-only, for Cloud Store's feeds. Signature
             permission, re-checked in call(); the token is never logged. -->
        <provider
            android:name=".cloud.FleetBearerProvider"
            android:authorities="${applicationId}.fleetbearer"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
        <!-- The fleet-diagnostics bridge: this app's About, Logcat and Diagnose for cloud-c3-webserver's cloud.app
             page (:8003). Read-only, signature permission, re-checked in call(); see FleetDiagnosticsProvider. -->
        <provider
            android:name=".cloud.FleetDiagnosticsProvider"
            android:authorities="${applicationId}.fleetdiag"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
        <!-- #777 swipe on one alert = that alert is done. Our own PendingIntent only. -->
        <receiver
            android:name=".notificationcenter.AlertsNotifier$DismissReceiver"
            android:exported="false" />
        <!-- #1506 Background policy: this app's own update re-applies the chosen policy once (PACKAGE_REPLACED for other apps is registered in App.onCreate). -->
        <receiver
            android:name=".bgpolicy.BgReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".notificationcenter.BadgeRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- HOME — the launcher door. Flips the SuperApp into the Android
             Home Screen replacement candidate list; once the user picks it as
             default, all Home button / home gesture presses route here.
             launchMode=singleTask + empty taskAffinity match the AOSP
             Launcher3 task semantics so back / recents behave as expected.

             This USED to be the same activity as the LAUNCHER entry below,
             and that is precisely why the SuperApp could never be put in
             split-screen: singleTask + an empty affinity means exactly one
             instance in exactly one task, the HOME intent puts that task in
             the home root task, and the home task gets no Overview card and
             is not a legal split half on handhelds. Tapping the drawer icon
             did not create an app task, it just brought the home-task
             instance forward. Two activities, two affinities, two tasks —
             same code (both are empty subclasses of ShellActivity), same
             process, same SharedPreferences, so Configs → Launcher and
             Configs → One-Hand keep driving the home screen from inside the
             app with no cross-process plumbing. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- LAUNCHER — the app door. Its OWN taskAffinity is the whole point:
             a distinct affinity puts this instance in its own task, which is
             what earns it an Overview card, and Overview is where the user
             picks the second half of a split. singleTop (not singleTask) so
             re-launching reuses the instance without tearing down the task.
             resizeableActivity is explicit rather than relying on the
             targetSdk-24 default, since this attribute is the one a reader
             will look for when asking why the app does or does not split. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.app"
            android:excludeFromRecents="false"
            android:resizeableActivity="true">
            <!-- Standard app-drawer entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher icon long-press shortcuts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Health Connect privacy-policy / rationale activity.
                 Without these intent-filters the Health Connect app
                 (or system module on API 34+) will NOT list the
                 Cloud SuperApp in its "App permissions" screen — the
                 user has no way to grant any HC perm.

                 androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE
                 is the legacy filter (Android 13 and earlier, HC as
                 a separate Play-Store app). VIEW_PERMISSION_USAGE +
                 category HEALTH_PERMISSIONS is the Android 14+
                 filter (HC is a system module, perms are standard
                 runtime perms). Both required — manifest-merger
                 leaves a single Activity entry hosting both. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: Health Connect's "app privacy" entry point. It MUST be an activity-alias guarded by
             START_VIEW_PERMISSION_USAGE (only the system may start it); the same filter on the activity itself
             is not recognised, and without it Health Connect will not list or grant this app's permissions. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Transparent trampoline that runs PermissionController's request contract (Health badge "Grant access"). -->
        <activity
            android:name=".notificationcenter.HealthGrantActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- RECOVERY — the direct-install screen, and the tap target for both
             the home banner and the advisory notification.

             Its own Activity, and its own task affinity, on purpose: it is the
             screen a device reaches when the normal update path is broken, so
             it must not depend on the launcher's tile-routing grammar to be
             reachable (a notification that routes through that grammar lands
             on Home the day the grammar changes). singleTop so a second
             advisory tap re-targets the open screen through onNewIntent
             instead of stacking copies of it. -->
        <activity
            android:name=".recovery.RecoveryActivity"
            android:exported="false"
            android:label="Recovery"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.recovery"
            android:excludeFromRecents="false" />

        <!-- Light tool (#1155): the Light page (rear torch / front white screen). The foreground service that keeps a lit
             torch alive past the page (timer or Keep on, with an Off action) is libs:light's, manifest-merged. -->
        <activity
            android:name=".light.LightActivity"
            android:exported="false"
            android:label="Light"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density">
            <!-- libs:light's Light.tileTap and the Off-action service's notification open the page through this action. -->
            <intent-filter>
                <action android:name="com.diegonmarcos.superapp.light.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- PowerStateReceiver moved to :libs:battery (manifest-merged). -->

        <!-- LockScreenAdminReceiver — Device Admin bind target needed for
             DevicePolicyManager.lockNow() (used by the home-screen
             double-tap-to-lock gesture). Single-policy scope (force-lock
             only) declared in res/xml/device_admin_policy.xml so the
             system activation dialog lists exactly one capability — no
             wipe / reset warnings. BIND_DEVICE_ADMIN is signature-level;
             the receiver MUST require it to be a valid admin target. -->
        <receiver
            android:name=".system.LockScreenAdminReceiver"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- LockScreenAccessibilityService — hosts the AccessibilityService.
             GLOBAL_ACTION_LOCK_SCREEN call (API 28+). Preferred path for
             the home double-tap-to-lock gesture because it preserves Smart
             Lock (Trusted Device / Trusted Place) + biometric unlock,
             unlike DevicePolicyManager.lockNow which trips the strong-auth
             bit and forces a PIN entry after the next wake. BIND_ACCESSIBILITY_SERVICE
             is signature-level; the service MUST require it to be a valid
             accessibility target. Config (zero events observed, no UI
             scraping, no gestures) lives in
             res/xml/lock_screen_accessibility_service.xml. -->
        <service
            android:name=".system.LockScreenAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_screen_accessibility_service" />
        </service>

        <!-- NotificationListenerService — surfaces every phone-system
             notification in the Infos/Admin "Phone Notifications" panel.
             Permission BIND_NOTIFICATION_LISTENER_SERVICE is signature-
             level, so declaring it is necessary but not sufficient: the
             user must additionally toggle our app ON in
             Settings → Special access → Notification access. The panel
             surfaces a CTA button that opens that screen directly. -->
        <service
            android:name=".notificationcenter.PhoneNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- FloatingNavService — the cross-app Floating Top Nav Bar overlay.
             Foreground service (START_STICKY) so it survives while the user is
             in other apps; type=specialUse because a launcher-companion overlay
             doesn't map to the predefined FGS categories. Not exported — only
             our own MainActivity / Permissions page start it, gated by
             Settings.canDrawOverlays + build.json::ui.floating_nav.enabled. -->
        <service
            android:name=".floatingnav.FloatingNavService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating cross-app navigation bar overlay for the Cloud SuperApp launcher" />
        </service>

        <!-- Invisible trampoline for notification action buttons — performs
             the action + finishes, which closes the notification shade. -->
        <activity
            android:name=".floatingnav.NavActionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true" />

        <!-- ScreensaverService — full-black cover overlay (Black-Screen-style;
             keeps apps playing underneath, no lock). Started from the
             floating-nav Screensaver action; same overlay + FGS perms. -->
        <service
            android:name=".floatingnav.ScreensaverService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Full-screen black screensaver overlay for the Cloud SuperApp launcher" />
        </service>

        <!-- KdeStatusService — pins the persistent "Cloud SA - KDE" status
             notification via startForeground (parity with FloatingNavService's
             "Cloud SA - Quick Actions"). type=specialUse: a KDE-Connect
             connection/pairing status badge doesn't map to a predefined FGS
             category. Not exported — only App.onCreate / KdeQuickActionReceiver
             start it. -->
        <service
            android:name=".notificationcenter.KdeStatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent KDE Connect connection + pairing status notification for the Cloud SuperApp" />
        </service>
        <!-- #517 HealthBadgeService — pins the persistent "Cloud SA - Health"
             badge (active kcal + km walked today, read from Health Connect).
             type=specialUse for the same reason as KdeStatusService: a
             standing activity-summary badge is not one of the predefined FGS
             categories, and it is emphatically NOT `health`, which is for
             active workout tracking. Not exported — only BadgeServices.ensureAll
             starts it, from the declaration. -->
        <service
            android:name=".notificationcenter.HealthBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent daily activity summary badge (active calories + distance) for the Cloud SuperApp" />
        </service>
        <!-- DataBadgeService - pins the persistent "Cloud SA - Data" badge (data
             used today / this month, mobile vs Wi-Fi, top apps, read through
             libs:datamanager). type=specialUse for the same reason as its
             siblings. Not exported - only BadgeServices.ensureAll starts it,
             from the declaration. -->
        <service
            android:name=".notificationcenter.DataBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent data-usage badge (today, month, top apps) for the Cloud SuperApp" />
        </service>
        <!-- AiBadgeService - pins the persistent "Cloud SA - AI" badge (Claude session and
             weekly used %, OpenRouter balance and spend, read from c3-infra-api
             GET /ai/usage). type=specialUse for the same reason as its siblings.
             Not exported - only BadgeServices.ensureAll starts it, from the declaration. -->
        <service
            android:name=".notificationcenter.AiBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent AI usage badge (Claude limits, OpenRouter spend) for the Cloud SuperApp" />
        </service>
        <!-- NetworkBadgeService — pins the persistent "Cloud SA - Network"
             badge (mesh state, IP, peers, rx/tx; Always On / Connect / More).
             type=specialUse for the same reason as its siblings: a standing
             connection-status badge is not one of the predefined FGS
             categories. It is NOT `systemExempted`/VPN: the tunnel lives in the
             engine APK; this only reads it over INetBackend. Not exported -
             only BadgeServices.ensureAll starts it, from the declaration. -->
        <service
            android:name=".notificationcenter.NetworkBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent mesh status badge (connection, IP, peers, traffic) for the Cloud SuperApp" />
        </service>
        <!-- BatteryBadgeService - pins the persistent "Cloud SA - Battery"
             badge (time to full / to empty first, then level, current,
             voltage, temperature, health, cycles, capacity). type=specialUse
             for the same reason as its siblings: a standing battery-status
             badge is not one of the predefined FGS categories. Not exported -
             only BadgeServices.ensureAll starts it, from the declaration. -->
        <service
            android:name=".notificationcenter.BatteryBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent battery status badge (time to full or empty, level, current, temperature) for the Cloud SuperApp" />
        </service>
        <!-- WeatherBadgeService — pins the persistent "Cloud SA - Weather"
             badge (current temp, day max/min, hourly forecast, place name;
             Open-Meteo + last-known location, no key). type=specialUse for the
             same reason as its siblings: a standing forecast badge is not one
             of the predefined FGS categories, and it is NOT `location` — that
             type is for apps actively tracking position, while this one only
             reads the last known fix. Not exported — only
             BadgeServices.ensureAll starts it, from the declaration. -->
        <service
            android:name=".notificationcenter.WeatherBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent today-forecast badge (current temp, day max/min, hourly) for the Cloud SuperApp" />
        </service>

        <!-- #517 MarketsBadgeService — pins the persistent "Cloud SA - Markets"
             badge (declared FX / crude / gold prices from Yahoo Finance).
             type=specialUse for the same reason as the two badge services
             above: a standing price ticker is not one of the predefined FGS
             categories. Not exported — only BadgeServices.ensureAll starts it,
             from the declaration. -->
        <service
            android:name=".notificationcenter.MarketsBadgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent market price badge (FX, crude and gold last prices) for the Cloud SuperApp" />
        </service>

        <!-- Shizuku provider — required by the Shizuku client lib so the
             app can talk to the Shizuku server (binder + permission).
             Backs the exact per-app energy attribution (ShizukuEnergy +
             ShizukuUserService running dumpsys batterystats in shell
             context). No-op when Shizuku isn't installed/running. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- #903 the dataSync foreground service a running batch (Download all /
             Update all / the auto chain / one row's Install) holds, so Android
             and Samsung's freezer leave the process and its network alone.
             libs:updater declares it too; restated here so this manifest is the
             record of what the app runs, and the merger folds the two. -->
        <service
            android:name="com.diegonmarcos.superapp.updater.BatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- #903 WorkManager's own foreground service runs the download/install
             workers' ForegroundInfo, so it needs the same type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
