<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (never in a release APK): the one screen the CI screenshot job types into
  (ac_cloud-keyboard/ci/keyboard-screenshots.sh). A plain text field that asks for the keyboard
  the moment it opens, so the job needs no other app on the emulator.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- #1754 debug builds only: the emulator walk (ci/grabber-shots.sh) starts Screen Selection straight from adb -->
        <activity android:name="com.diegonmarcos.cloudkeyboard.grabber.GrabberScreenActivity"
            android:exported="true" tools:replace="android:exported" />
        <activity
            android:name="com.diegonmarcos.cloudkeyboard.ShotActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    </application>
</manifest>
