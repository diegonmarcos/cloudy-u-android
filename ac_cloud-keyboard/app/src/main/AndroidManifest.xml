<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Keyboard — standalone IME APK.

  All core IME components (LatinIME service, SpellCheckerService, SettingsActivity,
  AndroidSpellCheckerService) are declared in :libs:keyboard AndroidManifest and
  merged here automatically by AGP. This manifest only adds the app-level things
  the library manifest cannot declare (applicationId-scoped providers).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GIF panel (libs:media) fetches from Giphy/Tenor over HTTPS. libs:media
         declares NO permissions by design — it delegates INTERNET to the
         consuming app (see its manifest comment). The superapp app declares
         these; the standalone keyboard must too, or httpGetJson() fails
         silently and the GIF tab is empty regardless of the baked API key.
         Stickers are local (bundled) so they work without this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission to bind the translate engine service in cloud-keyboard-libs
         (signature-level: both apps are signed with the same constellation key). -->
    <uses-permission android:name="com.diegonmarcos.cloudkeyboardlibs.BIND_ENGINE" />

    <!-- Tier 3 of the fleet autofill (a0_docs/eng-specs/autofill-3-tier.md): read Cloud Account's
         non-secret SOT (emails, phones, addresses, snippets) for the keyboard's own candidate row.
         Signature-level (libs:autofill defines it). Read only: the keyboard never writes the SOT. -->
    <uses-permission android:name="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_READ" />

    <!-- Clipboard export/import writes a fixed, user-visible folder
         (/sdcard/.cloud-keyboard/clipboard) so backups land in a predictable place
         instead of wherever a file picker happened to point. Requested at use time
         from Clipboard settings, never on launch. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- #1652 Writer tab > Voice Transcription (libs:writer-ui Listen): records the microphone, kept running by a microphone foreground
         service; POST_NOTIFICATIONS shows its notice on 13+. The on-device speech engine is the companion package queried below. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- #1754 Grabber > Screen Selection: the one frame of the screen is taken by a foreground service of type mediaProjection
         (Android 14 refuses the projection without it). A normal permission, granted at install. The capture itself needs no
         permission to declare: the system's screen-capture consent is asked on every capture and cannot be pre-granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 11+ package visibility: declare the companion libs package so
         PackageManager resolves it and bindService() succeeds. -->
    <queries>
        <package android:name="com.diegonmarcos.cloudkeyboardlibs" />
        <!-- #1754 Grabber's Ask and Drive actions hand the text to these apps by intent (GrabberRouter.PACKAGES) -->
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.diegonmarcos.cloudsuperintel" />
        <package android:name="com.diegonmarcos.cloudnotes" />
        <package android:name="com.diegonmarcos.cloudagenda" />
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
    </queries>

    <!-- WorkManager on-demand init: HeliBoard's manifest merge drops the default
         WorkManagerInitializer. Complete the on-demand setup here (App provides
         Configuration.Provider so the first getInstance() lazily initializes it). -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="false"
        android:directBootAware="false"
        tools:replace="android:name,android:label,android:allowBackup,android:defaultToDeviceProtectedStorage,android:directBootAware">

        <!-- #1652 Listen with the screen off (libs:writer-ui). Not exported: only this app starts or stops it. -->
        <service android:name="com.diegonmarcos.cloudwriter.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- FileProvider for keyboard Sticker/GIF panel (libs:media).
             Stickers picked via MediaPanelView are served as content:// URIs
             to the target app via InputConnection.commitContent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mediaprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/media_file_paths" />
        </provider>

        <!-- Bundled sticker packs (libs:media BundledStickerProvider).
             Authority ends with .stickercontentprovider so StickerRepo
             auto-discovers it alongside WhatsApp sticker apps. -->
        <provider
            android:name="com.diegonmarcos.superapp.media.BundledStickerProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- #1698 cloud-writer's Tools pages (libs:writer-ui), opened from the Writer tab > Tools; same shells as ac_cloud-writer. -->
        <activity android:name="com.diegonmarcos.cloudwriter.TextEnhanceActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="false"
            android:label="@string/settings_screen_enhance"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.diegonmarcos.cloudwriter.TranslationActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="false"
            android:label="@string/settings_screen_translation"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.diegonmarcos.cloudwriter.GrammarCheckActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="false"
            android:label="@string/settings_screen_grammar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.diegonmarcos.cloudwriter.AiRoutingActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="false"
            android:label="@string/settings_screen_ai_routing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.diegonmarcos.cloudwriter.RoutesActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="false"
            android:label="@string/settings_screen_routes"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- #1707 the retired standalone Cloud Writer's entry points, now the keyboard's Writer: text or an image shared in, text selected
             in another app (PROCESS_TEXT), and the explicit deep link other fleet apps use. Hosts libs:writer-ui's WriterSurface. -->
        <activity android:name=".WriterShareActivity"
            android:theme="@style/Theme.KeyboardWriterTools"
            android:exported="true"
            android:label="@string/writer_share_label"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- #1754 Grabber: the text-selection menu entry. Every app's selection toolbar lists activities that filter ACTION_PROCESS_TEXT; this
             one opens the Grabber bottom sheet over that app and, for an editable field, returns the result as EXTRA_PROCESS_TEXT. The
             Writer entry above stays. -->
        <!-- #1793 taskAffinity="": opened by the toolbar key or Grabber on selection (a NEW_TASK start) it sits over the app being
             used instead of bringing this app's settings window forward; the selection menu's start (for a result) is unaffected. -->
        <activity android:name=".grabber.GrabberActivity"
            android:theme="@style/Theme.CloudGrabber"
            android:taskAffinity=""
            android:exported="true"
            android:label="@string/grabber_menu_label"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- #1754 Grabber > Screen Selection: capture consent, region drag, on-device text read, then the same panel. Started by the
             Grabber page and the Quick Settings tile only. -->
        <activity android:name=".grabber.GrabberScreenActivity"
            android:theme="@style/Theme.CloudGrabber"
            android:taskAffinity=""
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <service android:name=".grabber.GrabberCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- #1793 Grabber on selection (accessibility): OFF until the user turns it on in Android's Accessibility settings AND the switch on
             Grabber > Text Selection. Subscribes to text-selection events only, no window content (res/xml/grabber_accessibility.xml). -->
        <service android:name=".grabber.GrabberSelectionService"
            android:exported="true"
            android:label="@string/grabber_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/grabber_accessibility" />
        </service>
        <!-- #1825 accessibility-free grabbing: the default digital assistant. When Cloud Keyboard is chosen in Settings > Apps > Default apps >
             Digital assistant app, the side/home long-press binds this service and starts the session, which receives the screen's text
             nodes (AssistStructure) and the screenshot and opens GrabberAssistActivity. No accessibility permission. -->
        <service android:name=".grabber.GrabberVoiceService"
            android:exported="true"
            android:label="@string/grabber_assist_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/grabber_voice_interaction" />
        </service>
        <service android:name=".grabber.GrabberVoiceSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".grabber.GrabberRecognitionService"
            android:exported="true"
            android:label="@string/grabber_assist_label" />
        <activity android:name=".grabber.GrabberAssistActivity"
            android:theme="@style/Theme.CloudGrabber"
            android:taskAffinity=""
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <service android:name=".grabber.GrabberTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_crop"
            android:label="@string/grabber_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- #1707 Writer OCR: Take picture writes the photo into this app's cache through this provider (no CAMERA permission). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ocr"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ocr_paths" />
        </provider>

        <!-- #1707 Registers /api/writer/* on the fleet debug server. Not exported, not a real provider. -->
        <provider
            android:name=".WriterDebugApiProvider"
            android:authorities="${applicationId}.writerdebugapi"
            android:exported="false" />
    </application>
</manifest>
