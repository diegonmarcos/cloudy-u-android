<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Keyboard — standalone IME APK.

  All core IME components (LatinIME service, SpellCheckerService, SettingsActivity,
  AndroidSpellCheckerService) are declared in :libs:keyboard AndroidManifest and
  merged here automatically by AGP. This manifest only adds the app-level things
  the library manifest cannot declare (applicationId-scoped providers).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GIF panel (libs:media) fetches from Giphy/Tenor over HTTPS. libs:media
         declares NO permissions by design — it delegates INTERNET to the
         consuming app (see its manifest comment). The superapp app declares
         these; the standalone keyboard must too, or httpGetJson() fails
         silently and the GIF tab is empty regardless of the baked API key.
         Stickers are local (bundled) so they work without this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission to bind the translate engine service in cloud-keyboard-libs
         (signature-level: both apps are signed with the same constellation key). -->
    <uses-permission android:name="com.diegonmarcos.cloudkeyboardlibs.BIND_ENGINE" />

    <!-- Tier 3 of the fleet autofill (a0_docs/eng-specs/autofill-3-tier.md): read Cloud Account's
         non-secret SOT (emails, phones, addresses, snippets) for the keyboard's own candidate row.
         Signature-level (libs:autofill defines it). Read only: the keyboard never writes the SOT. -->
    <uses-permission android:name="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_READ" />

    <!-- Clipboard export/import writes a fixed, user-visible folder
         (/sdcard/.cloud-keyboard/clipboard) so backups land in a predictable place
         instead of wherever a file picker happened to point. Requested at use time
         from Clipboard settings, never on launch. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- #1652 Writer tab > Voice Transcription (libs:writer-ui Listen): records the microphone, kept running by a microphone foreground
         service; POST_NOTIFICATIONS shows its notice on 13+. The on-device speech engine is the companion package queried below. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: declare the companion libs package so
         PackageManager resolves it and bindService() succeeds. -->
    <queries>
        <package android:name="com.diegonmarcos.cloudkeyboardlibs" />
    </queries>

    <!-- WorkManager on-demand init: HeliBoard's manifest merge drops the default
         WorkManagerInitializer. Complete the on-demand setup here (App provides
         Configuration.Provider so the first getInstance() lazily initializes it). -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="false"
        android:directBootAware="false"
        tools:replace="android:name,android:label,android:allowBackup,android:defaultToDeviceProtectedStorage,android:directBootAware">

        <!-- #1652 Listen with the screen off (libs:writer-ui). Not exported: only this app starts or stops it. -->
        <service android:name="com.diegonmarcos.cloudwriter.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- FileProvider for keyboard Sticker/GIF panel (libs:media).
             Stickers picked via MediaPanelView are served as content:// URIs
             to the target app via InputConnection.commitContent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mediaprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/media_file_paths" />
        </provider>

        <!-- Bundled sticker packs (libs:media BundledStickerProvider).
             Authority ends with .stickercontentprovider so StickerRepo
             auto-discovers it alongside WhatsApp sticker apps. -->
        <provider
            android:name="com.diegonmarcos.superapp.media.BundledStickerProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
