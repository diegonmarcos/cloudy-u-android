      "_doc_scenes": "#1369 Obsidian look review: each scene photographed in dark and light, Clean nav (cloud-android-nav-walk.py run_scenes). The push source is relative to 1_cicd (the directory the walk script resolves it against), hence the leading ../ : without it nothing was pushed and every vault scene was skipped on the start screen (Not a folder). #1717 the Vault view redesign: the app is restarted before every scene and the data is kept, so after `vault` mounted the sample vault every later scene finds it mounted again with its tabs (vault-tabs-restored is that proof: the tab switcher after a restart); sidebar tree / recent / filter, File view, Canvas view and the Source section are one scene each; the last scene puts the filter back to All files so the second theme pass starts from the same state (its `vault` scene then finds no start screen and is reported skipped).",
      "scene_nav_mode": "clean",
      "scene_themes": ["dark", "light"],
      "scene_boot_s": 10,
      "scene_theme_setup": [["shell", "pm clear {pkg}"], ["shell", "appops set --uid {pkg} MANAGE_EXTERNAL_STORAGE allow"]],
      "scene_setup": [["shell", "mkdir -p /sdcard/Documents"], ["push", "../ac_cloud-notes/test/fixtures/vault/sample", "/sdcard/Documents/sample-vault"], ["shell", "appops set --uid {pkg} MANAGE_EXTERNAL_STORAGE allow"]],
