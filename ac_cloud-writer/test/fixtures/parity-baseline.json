{
 "manifest": {
  "uses_permissions": [
   "android.permission.ACCESS_NETWORK_STATE",
   "android.permission.FOREGROUND_SERVICE",
   "android.permission.FOREGROUND_SERVICE_MICROPHONE",
   "android.permission.POST_NOTIFICATIONS",
   "android.permission.RECORD_AUDIO",
   "com.diegonmarcos.cloudkeyboardlibs.BIND_ENGINE"
  ],
  "queries": [
   "${voiceEnginePackage}"
  ],
  "application": {
   "android:label": "@string/app_name",
   "android:icon": "@mipmap/ic_launcher",
   "android:roundIcon": "@mipmap/ic_launcher_round",
   "android:supportsRtl": "true",
   "android:theme": "@style/Theme.CloudWriter"
  },
  "components": [
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.MainActivity",
     "android:exported": "true",
     "android:label": "@string/app_name",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode",
     "android:windowSoftInputMode": "adjustResize"
    },
    "filters": [
     {
      "actions": [
       "android.intent.action.MAIN"
      ],
      "categories": [
       "android.intent.category.LAUNCHER"
      ],
      "mime": []
     },
     {
      "actions": [
       "android.intent.action.SEND"
      ],
      "categories": [
       "android.intent.category.DEFAULT"
      ],
      "mime": [
       "text/plain"
      ]
     },
     {
      "actions": [
       "android.intent.action.SEND"
      ],
      "categories": [
       "android.intent.category.DEFAULT"
      ],
      "mime": [
       "image/*"
      ]
     },
     {
      "actions": [
       "android.intent.action.PROCESS_TEXT"
      ],
      "categories": [
       "android.intent.category.DEFAULT"
      ],
      "mime": [
       "text/plain"
      ]
     }
    ]
   },
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.TextEnhanceActivity",
     "android:exported": "false",
     "android:label": "@string/settings_screen_enhance",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode",
     "android:windowSoftInputMode": "adjustResize"
    },
    "filters": []
   },
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.TranslationActivity",
     "android:exported": "false",
     "android:label": "@string/settings_screen_translation",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode"
    },
    "filters": []
   },
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.GrammarCheckActivity",
     "android:exported": "false",
     "android:label": "@string/settings_screen_grammar",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode"
    },
    "filters": []
   },
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.AiRoutingActivity",
     "android:exported": "false",
     "android:label": "@string/settings_screen_ai_routing",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode"
    },
    "filters": []
   },
   {
    "tag": "activity",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.RoutesActivity",
     "android:exported": "false",
     "android:label": "@string/settings_screen_routes",
     "android:configChanges": "orientation|screenSize|screenLayout|keyboardHidden|uiMode"
    },
    "filters": []
   },
   {
    "tag": "service",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.ListenService",
     "android:exported": "false",
     "android:foregroundServiceType": "microphone"
    },
    "filters": []
   },
   {
    "tag": "provider",
    "attrs": {
     "android:name": "androidx.core.content.FileProvider",
     "android:authorities": "${applicationId}.ocr",
     "android:exported": "false",
     "android:grantUriPermissions": "true"
    },
    "filters": [],
    "meta": [
     {
      "android:name": "android.support.FILE_PROVIDER_PATHS",
      "android:resource": "@xml/ocr_paths"
     }
    ]
   },
   {
    "tag": "provider",
    "attrs": {
     "android:name": "com.diegonmarcos.cloudwriter.WriterDebugApiProvider",
     "android:authorities": "${applicationId}.writerdebugapi",
     "android:exported": "false"
    },
    "filters": []
   }
  ]
 },
