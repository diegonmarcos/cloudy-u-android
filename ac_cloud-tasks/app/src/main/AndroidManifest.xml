<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Agents ▸ Screenshot events: read Cloud Drive's Screenshot agent results through its
         provider (signature permission; contract ac_cloud-drive/data/agent-screenshots-contract.json). -->
    <uses-permission android:name="com.diegonmarcos.clouddrive.permission.READ_AGENT_RESULTS" />

    <queries>
        <package android:name="com.diegonmarcos.cloudagenda" />
        <!-- The cal ENGINE (build.json::engines.cal): without this line the engine is
             invisible on API 30+ and Cloud Tasks would say "install it" with it installed. -->
        <package android:name="${calEnginePackage}" />
        <!-- Cloud Drive: its Screenshot agent provider feeds Agents ▸ Screenshot events, and the Image / File
             attachments of a task open in it (build.json fleet row drive). -->
        <package android:name="${drivePackage}" />
        <!-- Cloud Mail: the mail agent reads it through its read-only agent provider (<package>.agentmail), the
             task editor's Mail picker lists its messages, and a Mail attachment opens it. Without this line
             Cloud Mail is invisible on API 30+ and reads exactly like "not installed". -->
        <package android:name="${mailPackage}" />
        <!-- Cloud Account: Profile ▸ Account opens it (com.diegonmarcos.cloudaccount.OPEN). -->
        <package android:name="${accountPackage}" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudTasks"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudTasks">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- #1766 a calendar app: the launcher's APP_CALENDAR slot. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CALENDAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- #1766 "Add to calendar" (CalendarContract.Events): title, beginTime, endTime, eventLocation, description, allDay, guests. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <!-- #1766 Cloud Mail's Intent carries only the data URI (CalendarContract.Events.CONTENT_URI), no type: without a calendar
                 provider on the device the system cannot derive the type, so the URI form is declared too. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="com.android.calendar" android:pathPrefix="/events" />
            </intent-filter>
            <!-- #1766 view an event / a moment of the calendar provider. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="com.android.calendar" android:pathPrefix="/events" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="time/epoch" />
                <data android:scheme="content" android:host="com.android.calendar" android:pathPrefix="/time" />
            </intent-filter>
            <!-- #1766 an iCalendar file (.ics) opened or shared, from a file or a content URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ics" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />
        <!-- projects/list on the fleet IPC door, for the SuperApp's Boards ▸ Tasks (registers before any Activity). -->
        <provider
            android:name=".ipc.ProjectsDebugApiProvider"
            android:authorities="${applicationId}.projectsapi"
            android:exported="false" />
    </application>
</manifest>
