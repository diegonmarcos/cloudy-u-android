<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tier 2 DOM autofill (a0_docs/eng-specs/autofill-3-tier.md): read Cloud Account's non-secret
         autofill SOT (profiles, site rules) and save an address only after the user confirms it.
         Both are signature permissions libs:autofill defines: fleet-signed apps only. -->
    <uses-permission android:name="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_READ" />
    <uses-permission android:name="com.diegonmarcos.cloud.permission.AUTOFILL_PROFILE_WRITE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- #802 a site may be allowed these per site (build.json::ui.browser.site_permissions);
         the app asks Android for them only when a site the user allowed first needs one. -->
    <!-- #1550 libs:bluetooth declares ACCESS_FINE_LOCATION with maxSdkVersion=30; strip that cap from the merged manifest so
         precise location is requestable on API 31+ (owner SM-A376B / API 36 was stuck on Approximate). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The download manager (libs:browser download/): its transfers run in ONE dataSync foreground
         service with an ongoing progress notification (Android 14+ needs the typed FGS permission),
         hold a partial WakeLock + WifiLock only while a transfer is running, and come back after a
         reboot (the persisted resume job + boot receiver). Android 8-9 publishes a finished file to
         the public Download/ folder with WRITE_EXTERNAL_STORAGE; 10+ uses MediaStore, no permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Self-update: download + install new APK from GHCR silently.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION is THE permission that makes
         USER_ACTION_NOT_REQUIRED actually silent on Android 12+ (API 31). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <!-- #1634 Weby lists every launchable app on the phone beside the SuperApp's Phone-apps folders (launcher apps only, no QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.diegonmarcos.cloudbrowser" />
        <!-- #802 I10 Cloud Vault (the vault add-on's requires_fleet, resolved by app/build.gradle). -->
        <package android:name="${vaultPackage}" />
        <!-- Cloud C3 WebServer: the browser starts its keep-alive service when a private name's server is down. -->
        <package android:name="${webserverPackage}" />
    </queries>

    <!-- #684 THE FLEET AUTH MISSION cloud-browser answers. The permission is SIGNATURE-level:
         only an app signed with the ONE constellation key (every fleet app) can start the mission,
         so no third-party app can ask this browser for a session cookie. Both names are the
         declared contract (ab_cloud-libs-shared/build.json::auth.browser_mission) with this app's
         package resolved by app/build.gradle. -->
    <permission
        android:name="${authMissionPermission}"
        android:protectionLevel="signature" />

    <application
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudBrowser"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CloudBrowser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Handle plain URL intents so other apps can open links in Cloud Browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- BitTorrent: magnet links and .torrent files from other apps go into the download queue
                 (torrent/TorrentIntents). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- Saved web pages (.mhtml / .mht): by type, then by name for the senders that give a generic type
                 (a file manager says application/octet-stream). One .* per extra dot in the name: the matcher
                 does not backtrack. file:// is loaded as it is; content:// is copied to the cache first (MhtmlOpener). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="multipart/related" />
                <data android:mimeType="message/rfc822" />
                <data android:mimeType="application/x-mimearchive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mhtml" />
                <data android:pathPattern=".*\\..*\\.mhtml" />
                <data android:pathPattern=".*\\..*\\..*\\.mhtml" />
                <data android:pathPattern=".*\\.mht" />
                <data android:pathPattern=".*\\..*\\.mht" />
                <data android:pathPattern=".*\\..*\\..*\\.mht" />
            </intent-filter>
            <!-- #1642 text files from other apps (Open with): shown as text (textopen/TextIntents). Text types only, never binary. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/x-log" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
            </intent-filter>
            <!-- #1642 text files a file manager reports with a generic type (octet-stream or empty): matched by extension, one .* per extra dot in the name (the matcher does not backtrack). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\..*\\.log" />
                <data android:pathPattern=".*\\..*\\..*\\.log" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.json" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\..*\\.csv" />
                <data android:pathPattern=".*\\..*\\..*\\.csv" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\..*\\.conf" />
                <data android:pathPattern=".*\\..*\\..*\\.conf" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\.yml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\..*\\.xml" />
                <data android:pathPattern=".*\\..*\\..*\\.xml" />
            </intent-filter>
            <!-- #1741 Cloud Browser is an image viewer (declared in build.json::image_viewer; ImageViewerManifestTest holds the two equal):
                 Open with / Share of a picture, from content:// (FileProvider, SAF, MediaStore) and file://. Shown by imageview/ImageIntents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- #1741 pictures a file manager reports with a generic type (octet-stream or empty): matched by extension, one .* per extra dot in the name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.png" />
                <data android:pathPattern=".*\\..*\\.png" />
                <data android:pathPattern=".*\\..*\\..*\\.png" />
                <data android:pathPattern=".*\\.jpg" />
                <data android:pathPattern=".*\\..*\\.jpg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpg" />
                <data android:pathPattern=".*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\.jpe" />
                <data android:pathPattern=".*\\..*\\.jpe" />
                <data android:pathPattern=".*\\..*\\..*\\.jpe" />
                <data android:pathPattern=".*\\.jfif" />
                <data android:pathPattern=".*\\..*\\.jfif" />
                <data android:pathPattern=".*\\..*\\..*\\.jfif" />
                <data android:pathPattern=".*\\.gif" />
                <data android:pathPattern=".*\\..*\\.gif" />
                <data android:pathPattern=".*\\..*\\..*\\.gif" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\..*\\.webp" />
                <data android:pathPattern=".*\\..*\\..*\\.webp" />
                <data android:pathPattern=".*\\.bmp" />
                <data android:pathPattern=".*\\..*\\.bmp" />
                <data android:pathPattern=".*\\..*\\..*\\.bmp" />
                <data android:pathPattern=".*\\.svg" />
                <data android:pathPattern=".*\\..*\\.svg" />
                <data android:pathPattern=".*\\..*\\..*\\.svg" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\..*\\.heic" />
                <data android:pathPattern=".*\\..*\\..*\\.heic" />
                <data android:pathPattern=".*\\.heif" />
                <data android:pathPattern=".*\\..*\\.heif" />
                <data android:pathPattern=".*\\..*\\..*\\.heif" />
                <data android:pathPattern=".*\\.avif" />
                <data android:pathPattern=".*\\..*\\.avif" />
                <data android:pathPattern=".*\\..*\\..*\\.avif" />
                <data android:pathPattern=".*\\.ico" />
                <data android:pathPattern=".*\\..*\\.ico" />
                <data android:pathPattern=".*\\..*\\..*\\.ico" />
                <data android:pathPattern=".*\\.wbmp" />
                <data android:pathPattern=".*\\..*\\.wbmp" />
                <data android:pathPattern=".*\\..*\\..*\\.wbmp" />
            </intent-filter>
            <!-- "Share" of a saved page. Not message/rfc822: every mail shared from any app would list this browser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="multipart/related" />
                <data android:mimeType="application/x-mimearchive" />
            </intent-filter>
        </activity>

        <!-- #684 the auth-mission answerer: exported but GUARDED by the signature permission
             above, and reachable only through the declared action. A fleet app fires it FOR A
             RESULT and gets the capture back; it is never launched from a launcher. -->
        <activity
            android:name=".AuthMissionActivity"
            android:exported="true"
            android:permission="${authMissionPermission}"
            android:label="@string/auth_mission_label"
            android:theme="@style/Theme.CloudBrowser">
            <intent-filter>
                <action android:name="${authMissionAction}" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- #913 THE FLEET AGENT DOOR (AgentApiContract): open a URL for the person in a named tab group, and a
             read-only fetch of one page's text. Both exported but guarded by the SIGNATURE permission, the
             AuthMissionActivity pattern: only a fleet app can call them. Nothing is clicked, filled or
             submitted over this door. -->
        <activity
            android:name=".agentapi.AgentOpenActivity"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudbrowser.action.AGENT_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name=".agentapi.AgentFetchProvider"
            android:authorities="${applicationId}.agentapi"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />

        <!-- The SuperApp search's browser-Fav / browser-History / browser-Web scopes
             (provider/BrowserLookup): read-only, text in and a few rows out, never an incognito
             page. Guarded by the SIGNATURE permission, the AgentFetchProvider pattern. -->
        <provider
            android:name=".provider.BrowserLookupProvider"
            android:authorities="${applicationId}.lookup"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />

        <!-- #1741 THE FLEET "CONVERT TO PDF" DOOR (build.json::image_viewer.convert_pdf_action): a fleet app (Cloud Drive's Convert section)
             hands an image or an HTML file as data; the browser opens it and raises Android's print framework, where "Save as PDF" writes
             the file. Signature-guarded like the agent door; it has no UI and is never launched from a launcher. -->
        <activity
            android:name=".imageview.ConvertPdfActivity"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.diegonmarcos.cloudbrowser.action.CONVERT_PDF" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- #802 registers /api/browser/* on the fleet debug server. Not exported, not a real provider. -->
        <provider
            android:name=".debugapi.BrowserDebugApiProvider"
            android:authorities="${applicationId}.browserdebugapi"
            android:exported="false" />

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />

        <!-- The download manager (libs:browser download/). DlService is the one foreground service every
             HTTP(S) download and torrent runs in (type dataSync); DlResumeJob brings unfinished downloads
             back after process death, a reboot or a network change; DlBootReceiver re-arms it after a boot
             or an update; DlFileProvider lets the app a file is opened or shared with read it. -->
        <!-- The torrent engine (libtorrent4j) libs:browser's DlTorrentBridge.load instantiates. -->
        <meta-data
            android:name="com.diegonmarcos.superapp.browser.TORRENT_BRIDGE"
            android:value="com.diegonmarcos.cloudbrowser.torrent.LtTorrentBridge" />
        <service
            android:name="com.diegonmarcos.superapp.browser.download.DlService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.diegonmarcos.superapp.browser.download.DlResumeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.diegonmarcos.superapp.browser.download.DlBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.diegonmarcos.superapp.browser.download.DlFileProvider"
            android:authorities="${applicationId}.dlfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dl_file_paths" />
        </provider>
    </application>
</manifest>
