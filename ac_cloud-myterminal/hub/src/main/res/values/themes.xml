<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 DayNight. The hub is a thin switcher, so the stock theme is
         all it needs — the rich theming lives inside each fork. -->
    <style name="Theme.CloudIde" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- #1675 targetSdk 34 -> 35 (silent updates on Android 17 need 35+). Android 15 ENFORCES edge-to-edge for apps
             targeting 35; this keeps the window exactly as it laid out at 34 (system bars outside the content). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
    </style>
</resources>
