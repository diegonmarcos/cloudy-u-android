<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for the in-app updater (GHCR OCI HTTP API). The hub itself
         does no sync; the forks own all file/server traffic. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updater: install the hub APK via PackageInstaller (user prompt)
         + post download/result notifications.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION is THE permission that makes
         USER_ACTION_NOT_REQUIRED (silent self-update) legal on Android 12+ —
         without it the OS silently downgrades every install to a prompt, so
         the updater's silent mode could never engage for this hub. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- #787 an open terminal shell keeps the CPU up (TerminalWakeLock), and asks once
         for the battery-optimization exemption through the standard prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Zero-setup sessions into the fleet's terminals (TerminalSessions → their
         CloudSessionService). Signature level: the system grants it only because this
         APK and the terminals carry the one fleet key, and refuses every other app.
         DEFINED here as well as in both terminals (same key, so the definitions agree),
         so the grant never depends on which of the three was installed first. -->
    <permission
        android:name="com.diegonmarcos.cloud.permission.TERMINAL_SESSION"
        android:label="Cloud terminal sessions"
        android:description="@string/perm_terminal_session"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.diegonmarcos.cloud.permission.TERMINAL_SESSION" />

    <!-- Package visibility (API 30+): the terminals named by data/terminal-targets.json
         ::backends.*.package (detected as installed, bound by package), any app serving
         the session action, and build.json::links.browser_package (Cloud Browser).
         test-terminal-session.sh fails when these drift from the declarations. -->
    <queries>
        <package android:name="cld.termux" />
        <package android:name="cld.termux.nix" />
        <package android:name="com.diegonmarcos.cloudbrowser" />
        <!-- #1675 Cloud Store (build.json::links.store_package), the fleet's one installer of record. -->
        <package android:name="com.diegonmarcos.cloudstore" />
        <intent>
            <action android:name="com.diegonmarcos.cloud.terminal.SESSION" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CloudIde"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Configs (Update + About). About = full SuperApp-architecture page
             (AboutActivity). Update = UpdateOverlay DialogFragment. -->
        <activity android:name=".ConfigsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".DevControlActivity" android:exported="false" />

        <!-- In-app updater + bundled-app PackageInstaller status callback. -->
        <receiver
            android:name=".update.PackageInstallerReceiver"
            android:exported="false" />

    </application>
</manifest>
